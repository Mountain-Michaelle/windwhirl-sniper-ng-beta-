
# Secrets and local configuration
.env
.env.*
!.env.example
!.env.template

# Python environments, bytecode, and test caches
.venv/
venv/
env/
__pycache__/
*.py[cod]
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Browser profiles, authentication state, and automation sessions
.sessions/
**/.sessions/
playwright/.cache/
**/user-data-dir/
**/browser-data/

# Generated runtime output
logs/
**/logs/
reports/
**/reports/
screenshots/
**/screenshots/
recordings/
**/recordings/
**/diagnostics/
**/closure_diagnostics/
**/runs/
test_out/
**/test_out/
.fingerprints/
**/.fingerprints/

# Local databases and transient database files
*.db
*.db-*
*.sqlite
*.sqlite3
*.sqlite-*

# Private or disposable input/output files
*.xlsx
*.xls
*.csv
*.pdf
*.zip
*.old
*.bak
*.tmp
*.temp
*.cache
*.crdownload
*.part
*~

# Managed client runtime workspaces and generated job state
**/clients/_inbox/
**/clients/_rejected/
**/clients/_needs_disambiguation/
**/clients/*/auth/
**/clients/*/browser/
**/clients/*/catalog/
**/clients/*/state/
**/clients/*/jobs/
**/customers/data/
**/customers/progress/
**/customers/manual_check/

# Log and diagnostic files
*.log
*.err
*.pma
*.dmp
*.dump

# Browser/session state and ad-hoc run droppings (never commit credentials
# or live login state)
session_state.json
session_state.json.*
*.meta.json
*.sessionstorage.json
*_pid.txt
*.pid
_s1.txt
.kilo/

# Credentials (kept on disk, must never be pushed)
passwords_custom.txt
passwords_full.txt
**/passwords_*.txt

# Generated job/registry state that the app rewrites at runtime
**/clients/_registry.json
**/*_checkpoint_*.json

# Backup copies of source files
*.bak-*

# Editor and operating-system files
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db
Desktop.ini

# Build and packaging output
build/
dist/
*.egg-info/
*.whl