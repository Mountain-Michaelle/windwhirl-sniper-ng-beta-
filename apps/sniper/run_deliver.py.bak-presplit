    SqliteDeliverStore,
    normalize_phone,
    phone_keys,
    phone_matches,
)
from apps.sniper.run_upload import (  # noqa: E402  (reuse login machinery)
    LOGGED_IN_SELECTOR,
    LOGIN_URL,
    TARGET_URL,
    MissingCredentialsError,
    login_with_session_cache,
)

# ============================ constants =====================================

LOGIN_TIMEOUT_MS = 50_000
NAV_TIMEOUT_MS = 40_000

# Used by both the initial login and the browser-recovery re-login, plus the
# _confirm_orders_page() second check.
LOGIN_NETWORK_WAIT_MS = 100_000

PER_ORDER_DEADLINE_S = 90          # watchdog: never sit on one customer
MAX_BROWSER_RECOVERIES = 3
MAX_NETWORK_WAIT_S = 600           # total pause for one network outage
NETWORK_PROBE_URL = "https://www.google.com/generate_204"
VERIFY_ATTEMPTS = 4

# The filter bar (chips, Period, User) renders as a SECOND wave after the
# base orders page ("Add Order" button) is ready.
FILTERS_READY_TIMEOUT_MS = 20_000

# FIX: the User trigger is disabled by the CRM until a "Filter By" chip is
# applied. Wait for it to become enabled instead of a blind 30s click.
USER_ENABLE_TIMEOUT_MS = 15_000
# FIX: how long a chip gets to render after its option/Confirm was clicked.
CHIP_CONFIRM_TIMEOUT_MS = 2_500
# Plan doc §1: the UI collapses below `md`; use >= 1440x900.
MIN_VIEWPORT = (1440, 900)

TARGET_STATUS = "Delivered"
DEFAULT_AGENT = "Lagos"
DEFAULT_PERIOD = "This Month"
FORM_CHIP = "combo set"
# Live label is "Assigned To" (the plan doc says "Assigned By"); either
# spelling is accepted wherever a chip is looked up (see CHIP_ALIASES).
FILTER_CHIPS = ("Added By", "Assigned To")
CHIP_ALIASES = {
    "Assigned To": ("Assigned To", "Assigned By"),
    "Assigned By": ("Assigned To", "Assigned By"),
}

# FIX: label spellings each multi-select filter group may be rendered with
# (matched case-insensitively).
GROUP_LABEL_ALIASES = {
    "Order by Forms": ("Order by Forms", "Order by Form", "Forms", "Form"),
    "Filter By": ("Filter By", "Filters", "Filter"),
}
CONFIRM_BUTTON_RX = re.compile(r"^\s*(?:confirm|apply|done|ok)\s*$", re.I)

# Durable state machine (doc §3)
DISCOVERED = "DISCOVERED"
ROW_FOUND = "ROW_FOUND"
MENU_OPEN = "MENU_OPEN"
STATUS_MENU_OPEN = "STATUS_MENU_OPEN"
MODAL_OPEN = "MODAL_OPEN"
FIELDS_SELECTED = "FIELDS_SELECTED"
READY_TO_SAVE = "READY_TO_SAVE"
SAVE_SUBMITTED = "SAVE_SUBMITTED"
VERIFYING = "VERIFYING"
SUCCESS = "SUCCESS"
FAILED_RETRYABLE = "FAILED_RETRYABLE"
WAITING_FOR_NETWORK = "WAITING_FOR_NETWORK"
WAITING_FOR_BROWSER = "WAITING_FOR_BROWSER"
FAILED_FINAL = "FAILED_FINAL"

# ============================ selectors =====================================
# Radix portals: scope to visible/open elements; NEVER generated radix ids.

TAB_BASE = "div.group.relative.inline-flex.cursor-pointer"
PENDING_TAB = 'div.group.relative.inline-flex.cursor-pointer:has-text("Pending")'
DELIVERED_TAB = (
    'div.group.relative.inline-flex.cursor-pointer:has-text("Delivered")'
)
QUICK_SEARCH = 'input[placeholder^="Quick search"]'
QUICK_SEARCH_FALLBACK = 'input[enterkeyhint="search"]'
SEARCH_BUTTON_FALLBACK = 'button:has(svg.lucide-search):has-text("Search")'
SEARCH_BUTTON_LEGACY = 'button:has-text("Search")'
ROW_MENU_TRIGGER = 'td:nth-child(2) button[aria-haspopup="menu"]'
OPEN_MENU = 'div[role="menu"][data-state="open"]'
SUBMENU = 'div[data-side="right"][role="menu"][data-state="open"]'
MODAL = 'div[role="dialog"][data-state="open"]'
MODAL_TITLE = "Mark order as Delivered"
STATUS_CELL_INDEX = 9      # 0-based: Order Status column
CUSTOMER_CELL_INDEX = 5    # 0-based: Customer Name column
CONTACT_CELL_INDEX = 6     # 0-based: Contact column (tel: + wa.me links)
AMOUNT_RE = re.compile(r"[₦#]\s*([\d,]+)")
# Plan doc §2.8 b: expected amount = `Amount: ₦N` in the Product cell (the
# cell can also carry other ₦ figures, so "first ₦ number" can be wrong).
AMOUNT_LABELED_RE = re.compile(r"Amount:?\s*[₦#]\s*([\d,]+)", re.I)

TABLE_ROW = "tbody tr"
# FIX (this revision, "NOT_FOUND for a customer the Pending table DOES
# show"): the empty state ("No orders match your filters") is a
# `<tr><td colspan="28">` row INSIDE the same tbody, so `tbody tr` counted it
# as a data row -- an explicitly empty result was never recognised as empty
# and wait_for_app_idle() returned instantly on an empty table. Every REAL
# data row has >= 6 <td> cells (find_row() relies on the same rule).
TABLE_ROW_DATA = TABLE_ROW + ":has(td:nth-child(6))"
PERIOD_TRIGGER = 'div:has(> div > label:text-is("Period")) button[role="combobox"]'
USER_TRIGGER = 'div:has(> label:text-is("User")) button[role="combobox"]'
CMDK_POPOVER = 'div[data-side="top"][role="dialog"][data-state="open"]:has([cmdk-root])'
CMDK_POPOVER_FALLBACK = 'div[role="dialog"][data-state="open"]:has([cmdk-root])'
CMDK_ITEM = '[cmdk-item][role="option"]'
CMDK_ITEM_NOT_OTHER = '[cmdk-item][role="option"]:not([data-value^="Other "])'
CMDK_ITEM_SALES_REP = '[data-value^="Sales Rep "]'
USER_SENTINELS = ("all", "all users", "all time", "select", "any", "all staff")

# FIX: multi-select popup used by "Order by Forms" / "Filter By".
POPUP_SELECTOR = '[role="dialog"][data-state="open"], [role="listbox"], [cmdk-root]'
POPUP_OPEN_VISIBLE = '[role="dialog"][data-state="open"]:visible'
OPTION_SELECTORS = ('[cmdk-item], [role="option"], [role="menuitemcheckbox"], '
                    '[role="checkbox"], label')

# ============================ small helpers =================================


def now_iso() -> str:
    return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def atomic_write_json(path: Path, value) -> None:
    """Atomic checkpoint (doc §23): tmp write + rename, so power loss can
    never leave a half-written state file behind."""
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_name(path.name + ".tmp")
    tmp.write_text(json.dumps(value, indent=2, default=str), encoding="utf-8")
    os.replace(tmp, path)


def load_json(path: Path, default):
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except Exception:
        return default


def fingerprint(client: str, period: str, order_id: str) -> str:
    """doc §17: identity is client|period|orderId -- never name+amount,
    because two different orders can share both."""
    return f"{client}|{period}|{order_id}"


def backoff_delay(attempt: int) -> float:
    """doc §19: 500ms, 1s, 2s, 4s, 8s capped, with small jitter."""
    base = min(0.5 * (2 ** max(0, attempt - 1)), 8.0)
    return base + random.uniform(0.0, 0.15)


def _confirm_orders_page(page, timeout_ms: int = LOGIN_NETWORK_WAIT_MS) -> None:
    """Extra margin after login_with_session_cache() returns, mirroring
    run_automation.py's own belt-and-suspenders check. A session can report
    success while the orders page is still finishing its first render --
    especially on a cold/first-time session for a client, which has no
    session_state.json yet and must take the slower fresh-login path -- so
    this gives it a second, longer window before anything downstream (row
    search, filters, menus) touches the DOM.

    If the button still isn't there after that full window, one reload +
    retry before giving up: a stuck/half-rendered page is usually fixed by
    a fresh navigation, not by waiting even longer on the same load. If it
    STILL fails after the reload, the PWTimeoutError propagates up exactly
    as before -- this never silently swallows a genuine failure.
    """
    try:
        page.wait_for_selector(LOGGED_IN_SELECTOR, timeout=timeout_ms)
        return
    except PWTimeoutError:
        pass
    page.reload(wait_until="commit")
    page.wait_for_selector(LOGGED_IN_SELECTOR, timeout=timeout_ms)


def _ensure_viewport(page) -> None:
    """Plan doc §1: the CRM UI collapses below `md`, so use a viewport of at
    least 1440x900. Only acts when the context has a fixed viewport (a
    `no_viewport` headful window reports None and is left alone). Best
    effort: never raises."""
    try:
        size = page.viewport_size
        if size and (size["width"] < MIN_VIEWPORT[0]
                     or size["height"] < MIN_VIEWPORT[1]):
            page.set_viewport_size({
                "width": max(size["width"], MIN_VIEWPORT[0]),
                "height": max(size["height"], MIN_VIEWPORT[1]),
            })
    except Exception:
        pass


def clean_name(name: str) -> str:
    """Whitespace/case-insensitive key for matching customer names."""
    return re.sub(r"\s+", " ", (name or "").strip()).casefold()


def join_name_parts(parts) -> str:
    """Join the CRM's customer-name lines into ONE name.

    FIX (this revision, "NOT_FOUND for a customer the Pending table DOES
    show"): the CRM renders one `span.block` PER NAME LINE, and the
    customer's own form answer decides where it breaks --
    `<span class="block">Oladunni folasade</span><span class="block">Ramat
    </span>` for the sheet row "Oladunni folasade Ramat", while "Ewumi
    Elizabeth" stays a single block. Reading only the first block truncated
    the name, so a row that WAS on screen could never match.
    """
    return " ".join(p.strip() for p in (parts or []) if p and p.strip())


def names_match(want: str, shown: str) -> bool:
    """True when the CRM's shown name IS the wanted customer name
    (whitespace/case-insensitive)."""
    return bool(want) and clean_name(want) == clean_name(shown)


def is_name_candidate(want: str, shown: str) -> bool:
    """Guarded fallback for the two ways the CRM name can differ from the
    sheet name, `want` (sheet) vs `shown` (CRM):

      * the CRM holds MORE of it -- 'Blessing' -> 'Blessing Okon' (this is
        what the old whole-word fallback did, so it is kept); or
      * the CRM holds only PART of it -- 'Oladunni folasade Ramat' ->
        'Oladunni folasade' (the real live case). That direction needs the
        CRM fragment to carry at least two words: ONE word of a longer name
        ('John' for 'John Okon') is too weak to move an order on.

    Only a whole-word PREFIX counts (never a substring in the middle, never
    a re-ordering), and find_row() additionally requires the candidate to be
    the ONLY one on screen before it acts on it.
    """
    a, b = clean_name(want), clean_name(shown)
    if not a or not b or a == b:
        return False
    if b.startswith(a + " "):               # CRM holds more than the sheet
        return True
    return a.startswith(b + " ") and len(b.split()) >= 2


def phones_from_hrefs(hrefs) -> list:
    """The phone number(s) a Contact cell carries, from its links.

    The CRM renders the customer's phone as `<a href="tel:...">` and their
    WhatsApp as `<a href="https://wa.me/...">`, and the two values can be
    DIFFERENT numbers, so both are returned (normalised, de-duplicated).
    """
    found: list = []
    for href in hrefs or []:
        text = str(href or "")
        if text.lower().startswith("tel:"):
            value = text[4:]
        elif "wa.me/" in text:
            value = text.split("wa.me/", 1)[1]
        else:
            continue
        value = re.split(r"[?#]", value, 1)[0]
        key = normalize_phone(value)
        if key and key not in found:
            found.append(key)
    return found


PRICE_HEADERS = ("price", "total amount", "amount", "total", "order amount",
                 "amount paid", "total amount paid", "product amount",
                 "selling price")


def _norm_header(text_value) -> str:
    """'Price (₦)' / ' PRICE (NGN) ' / 'Price' -> 'price': lower-case, any
    '(...)' currency/unit suffix dropped, whitespace collapsed."""
    text_value = re.sub(r"\(.*?\)", " ", str(text_value or ""))
    return re.sub(r"\s+", " ", text_value).strip().lower()


def parse_price(raw):
    """'₦28,500' / 28500.0 / '28500' -> 28500 (int when whole), else None."""
    if raw is None or isinstance(raw, bool):
        return None
    if isinstance(raw, (int, float)):
        value = float(raw)
    else:
        digits = re.sub(r"[^\d.]", "", str(raw).replace(",", ""))
        if not digits:
            return None
        try:
            value = float(digits)
        except ValueError:
            return None
    if value <= 0:
        return None
    return int(value) if value == int(value) else round(value, 2)


def _cell_text(row: list, idx: int | None) -> str:
    """Row cell as trimmed text ('' for short rows / None cells)."""
    if idx is None or idx >= len(row):
        return ""
    value = row[idx]
    return str(value).strip() if value is not None else ""


# Last _select_work_rows() summary; printed once by main() so the sheet
# driven selection is always visible in the log.
_selection_note = ""


def _select_work_rows(body_rows: list[list], name_idx: int,
                      status_idx: int | None,
                      key_idx: int | None = None) -> tuple[list[list], str]:
    """The sheet status rule, shared by EVERY loader (names, prices,
    phones) so all three always see the exact same rows.

    A real data row is identified by the filtered s/n column ("Filtered #"
    / "S/N") when the sheet has one -- else by the name column; other
    empty cells never disqualify a row. "Blank" is judged ONLY on the
    status column of real rows:
    * no status column, or every real status blank -> every real row is
      work (the whole file is ready to be moved to delivered);
    * ANY status marked -> the marked column is the tracker: ONLY rows
      whose status starts with "delivered" are work -- those are the
      rows the sheet says to move. Pending / Scheduled / Cancelled rows
      and blank-status rows are ignored even when they are the majority,
      and a marked column with zero Delivered rows means NOTHING to
      process (no silent fall back to "everything").
    Returns (work_rows, human-readable summary).
    """
    global _selection_note
    id_idx = key_idx if key_idx is not None else name_idx
    real = [row for row in body_rows if _cell_text(row, id_idx)]
    if status_idx is None:
        note = "no status column -> all names are work"
        _selection_note = note
        return real, note
    counts: dict[str, int] = {}
    blank = 0
    for row in real:
        value = _cell_text(row, status_idx).lower()
        if value:
            counts[value] = counts.get(value, 0) + 1
        else:
            blank += 1
    if not sum(counts.values()):
        note = (f"status column entirely blank ({blank} row(s)) "
                "-> all names are work")
        _selection_note = note
        return real, note
    work_rows = [row for row in real
                 if _cell_text(row, status_idx).lower()
                 .startswith("delivered")]
    others = sorted(((value, num) for value, num in counts.items()
                     if not value.startswith("delivered")),
                    key=lambda item: -item[1])
    note = (f"{len(work_rows)} delivered, "
            f"{sum(counts.values()) - len(work_rows)} other"
            + (f" ({', '.join(f'{num} {value}' for value, num in others)})"
               if others else "")
            + f", {blank} blank -> processing {len(work_rows)}")
    if not work_rows:
        note += " -- NOTHING to process (no row marked Delivered)"
    _selection_note = note
    return work_rows, note


# A Price cell holding a phone number parses to billions of naira (live
# example: sheet cell 7049528233 = the customer's 07049528233). Anything
# past this cap is data-entry noise, not a price, and is ignored so the
# CRM row Amount is used instead of being saved as the order Total.
MAX_PLAUSIBLE_PRICE = 5_000_000


def load_customer_prices(path: Path, price_column: str = ""):
    """Excel/CSV price per customer, if the file has a price column.
    Returns (prices {clean_name: price}, column_header_used, conflicts).
    Rows follow the shared _select_work_rows() status rule (only rows
    marked Delivered when the sheet marks any status; every real row
    when the status column is blank/absent; real rows keyed by the
    filtered s/n column when present); a name that appears with
    different prices is dropped into `conflicts` (the CRM row Amount is
    used for it instead). A price above MAX_PLAUSIBLE_PRICE (a phone
    number typed into the Price cell) is ignored for the same reason."""
    suffix = path.suffix.lower()
    if suffix in (".xlsx", ".xls"):
        import openpyxl
        wb = openpyxl.load_workbook(str(path), read_only=True, data_only=True)
        rows = [list(r) for r in wb.active.iter_rows(values_only=True)]
    elif suffix == ".csv":
        with open(path, encoding="utf-8-sig", newline="") as fh:
            rows = [r for r in csv.reader(fh)]
    else:
        return {}, "", set()
    if not rows:
        return {}, "", set()
    header = [str(c).strip().lower() if c is not None else ""
              for c in rows[0]]
    header_norm = [_norm_header(c) for c in rows[0]]

    def _find(*wanted: str):
        for want in wanted:                       # exact header first...
            for i, h in enumerate(header):
                if h == want:
                    return i
        for want in wanted:                       # ...then ignoring "(₦)" etc.
            for i, h in enumerate(header_norm):
                if h == _norm_header(want):
                    return i
        return None

    name_idx = _find("customer name")
    if name_idx is None:
        name_idx = 0
    key_idx = _find("filtered #", "filtered#", "filtered", "s/n", "sn")
    price_idx = None
    if price_column:
        price_idx = _find(price_column.strip().lower())
    else:
        price_idx = _find(*PRICE_HEADERS)
        if price_idx is None:
            for i, h in enumerate(header):
                if "amount" in h or "price" in h:
                    price_idx = i
                    break
    if price_idx is None:
        return {}, "", set()
    status_idx = _find("action", "order status", "status")
    body, _ = _select_work_rows(rows[1:], name_idx, status_idx, key_idx)
    prices: dict = {}
    conflicts: set = set()
    for row in body:
        if name_idx >= len(row) or price_idx >= len(row):
            continue
        name = clean_name(str(row[name_idx]) if row[name_idx] is not None
                          else "")
        price = parse_price(row[price_idx])
        if not name or price is None:
            continue
        if price > MAX_PLAUSIBLE_PRICE:   # phone number in the Price cell
            continue
        if name in prices and prices[name] != price:
            conflicts.add(name)
        prices.setdefault(name, price)
    for name in conflicts:
        prices.pop(name, None)
    return prices, str(rows[0][price_idx]).strip(), conflicts


PHONE_HEADERS = ("phone number", "phone", "whatsapp number", "whatsapp",
                 "customer phone", "contact", "mobile")


def load_customer_phones(path: Path):
    """{clean_name(customer): [phone, ...]} from the sheet's phone columns.

    The CRM's Contact cell shows the customer's phone (`tel:`) AND their
    WhatsApp (`wa.me`) number, and those can differ, so every phone-ish
    column ('Phone Number', 'WhatsApp Number', ...) is captured and values
    are normalised with the store's phone_keys(). Same row rule as
    load_customers()/load_customer_prices() via _select_work_rows():
    when the sheet marks any status, only Delivered rows are used; when
    the status column is blank/absent, every real row (keyed by the
    filtered s/n column when present) is used. Returns
    (phones, headers_used) and
    never raises for an unreadable/odd file (callers treat {} as 'no phone
    identity available', which is exactly the old behaviour).
    """
    suffix = path.suffix.lower()
    if suffix in (".xlsx", ".xls"):
        import openpyxl
        wb = openpyxl.load_workbook(str(path), read_only=True, data_only=True)
        rows = [list(r) for r in wb.active.iter_rows(values_only=True)]
    elif suffix == ".csv":
        with open(path, encoding="utf-8-sig", newline="") as fh:
            rows = [r for r in csv.reader(fh)]
    else:
        return {}, ()
    if not rows:
        return {}, ()

    header = [str(c).strip().lower() if c is not None else "" for c in rows[0]]

    def _find(*wanted: str):
        for want in wanted:
            for i, h in enumerate(header):
                if h == want:
                    return i
        return None

    name_idx = _find("customer name")
    if name_idx is None:
        name_idx = 0
    key_idx = _find("filtered #", "filtered#", "filtered", "s/n", "sn")
    phone_cols = [i for i, h in enumerate(header)
                  if "phone" in h or "whatsapp" in h]
    if not phone_cols:
        idx = _find(*PHONE_HEADERS)
        phone_cols = [idx] if idx is not None else []
    if not phone_cols:
        return {}, ()

    status_idx = _find("action", "order status", "status")
    body, _ = _select_work_rows(rows[1:], name_idx, status_idx, key_idx)
    phones: dict = {}
    for row in body:
        if name_idx >= len(row):
            continue
        name = clean_name(str(row[name_idx]) if row[name_idx] is not None
                          else "")
        if not name:
            continue
        found = list(phones.get(name, []))
        for i in phone_cols:
            if i >= len(row):
                continue
            for key in phone_keys(row[i]):
                if key not in found:
                    found.append(key)
        if found:
            phones[name] = found
    used = tuple(str(rows[0][i]).strip() for i in phone_cols)
    return phones, used


NOT_FOUND_COLUMNS = ("exportedAt", "client", "customer", "excelPrice",
                     "whatWasSeen", "sourceFile", "runId")


def export_not_found(path: Path, client: str, customer: str, detail: str,
                     price, source: str, run_id: str) -> bool:
    """Append a customer that is in neither Pending nor Delivered to a CSV
    so a human can find out why (name not uploaded / misspelt). One row per
    name: a name already listed is not added again. True if a row was
    written."""
    path.parent.mkdir(parents=True, exist_ok=True)
    listed = set()
    if path.exists():
        with open(path, encoding="utf-8-sig", newline="") as fh:
            for row in csv.DictReader(fh):
                listed.add(clean_name(row.get("customer", "")))
    if clean_name(customer) in listed:
        return False
    is_new = not path.exists()
    with open(path, "a", encoding="utf-8-sig", newline="") as fh:
        writer = csv.writer(fh)
        if is_new:
            writer.writerow(NOT_FOUND_COLUMNS)
        writer.writerow([now_iso(), client, customer,
                         "" if price is None else price, detail, source,
                         run_id])
    return True


class WatchdogTimeout(RuntimeError):
    """doc §22: one customer exceeded its execution deadline."""


class ShutdownRequested(RuntimeError):
    """doc §29: SIGINT/SIGTERM -- persist and exit cleanly."""


class DeliverError(RuntimeError):
    """Retryable flow failure with a machine-readable step."""

    def __init__(self, step: str, reason: str, retryable: bool = True):
        super().__init__(f"{step}: {reason}")
        self.step = step
        self.reason = reason
        self.retryable = retryable


class OrderRecord:
    """One order's persistent state-machine row (doc §3)."""

    __slots__ = ("data",)

    def __init__(self, data: dict):
        self.data = data

    @property
    def order_id(self) -> str:
        return self.data.get("orderId") or ""

    @property
    def state(self) -> str:
        return self.data.get("state", DISCOVERED)

    def transition(self, state: str, **extra) -> None:
        self.data["state"] = state
        self.data["updatedAt"] = now_iso()
        self.data.update(extra)
        if state in (FAILED_RETRYABLE, FAILED_FINAL):
            self.data["attempt"] = int(self.data.get("attempt", 0)) + 1



# ============================ persistence ===================================


class DeliverStore:
    """File-backed state for one deliver job (doc §3/§23/§26)."""

    def __init__(self, client_id: str, period: str, root: Path):
        self.client_id = client_id
        self.period = period
        self.root = root
        self.root.mkdir(parents=True, exist_ok=True)
        self.state_path = root / "state.json"
        self.processed_path = root / "processed.json"
        self.report_path = root / "report.json"
        self.lock_path = root / "locks" / "deliver.lock"
        self.screens_dir = root / "screens"
        self.state = load_json(self.state_path, {"orders": {}})
        self.processed = load_json(self.processed_path, {})
        self.shutdown = False

    def record(self, customer: str, order_id: str = "",
               phone="") -> OrderRecord:
        key = fingerprint(self.client_id, self.period,
                          order_id or f"name:{customer}")
        orders = self.state.setdefault("orders", {})
        if key not in orders:
            orders[key] = {
                "key": key,
                "customer": customer,
                "orderId": order_id,
                "state": DISCOVERED,
                "attempt": 0,
                "createdAt": now_iso(),
            }
        rec = OrderRecord(orders[key])
        if order_id and rec.order_id != order_id:
            rec.data["orderId"] = order_id
        wanted = " ".join(phone_keys(phone))
        if wanted and rec.data.get("phone") != wanted:
            rec.data["phone"] = wanted
        return rec

    def checkpoint(self) -> None:
        atomic_write_json(self.state_path, self.state)

    def is_done(self, customer: str, phones=None) -> bool:
        """True when this customer was already delivered.

        `phones` (the sheet's Phone/WhatsApp value) keeps two DIFFERENT
        people who share a name apart: a success stored against another
        number does not count, so the second customer is still processed. A
        legacy entry with no stored phone still counts (nothing to compare).
        """
        wanted = phone_keys(phones)
        for entry in self.processed.values():
            if (entry.get("customer") != customer
                    or entry.get("status") != TARGET_STATUS):
                continue
            stored = phone_keys(entry.get("phone"))
            if not wanted or not stored or phone_matches(stored, wanted):
                return True
        return False

    def mark_success(self, rec: OrderRecord, order_id: str,
                     phone="") -> None:
        rec.transition(SUCCESS, lastStep="verify")
        key = fingerprint(self.client_id, self.period, order_id)
        entry = {
            "key": key,
            "orderId": order_id,
            "customer": rec.data["customer"],
            "status": TARGET_STATUS,
            "completedAt": now_iso(),
        }
        if phone_keys(phone):
            entry["phone"] = " ".join(phone_keys(phone))
        self.processed[key] = entry
        rec.data["orderId"] = order_id
        self.checkpoint()
        atomic_write_json(self.processed_path, self.processed)

    def mark_failed(self, rec: OrderRecord, step: str, reason: str,
                    final: bool) -> None:
        rec.transition(FAILED_FINAL if final else FAILED_RETRYABLE,
                       lastStep=step, reason=reason)
        self.checkpoint()

    def evidence(self, page, rec: OrderRecord, step: str, reason: str) -> None:
        """doc §25: screenshot + DOM + structured event for failures."""
        slug = re.sub(r"[^A-Za-z0-9_.-]+", "_",
                      f"{rec.data.get('customer', 'x')}_{step}")[:80]
        try:
            self.screens_dir.mkdir(parents=True, exist_ok=True)
            page.screenshot(path=str(self.screens_dir / f"{slug}.png"),
                            full_page=True)
            (self.screens_dir / f"{slug}.html").write_text(
                page.content(), encoding="utf-8")
        except Exception:
            pass
        try:
            with open(self.root / "events.jsonl", "a", encoding="utf-8") as fh:
                fh.write(json.dumps({
                    "ts": now_iso(),
                    "customer": rec.data.get("customer"),
                    "orderId": rec.order_id,
                    "state": rec.state,
                    "attempt": rec.data.get("attempt", 0),
                    "step": step,
                    "reason": reason,
                }) + "\n")
        except Exception:
            pass



# ============================ config / customers ============================


def load_customers(path: Path, only_pending: bool = True) -> list[str]:
    """Customer names from .txt (one per line) / .csv / .json / .xlsx.

    Header-aware for xlsx/csv (the sniper export layout): names come from
    the 'Customer Name' column (else the first column). The status rule
    lives in _select_work_rows(): a real data row is keyed by the
    filtered s/n column ("Filtered #" / "S/N") when present, else the
    name column. With a status column ('Action' / 'Order Status' /
    'Status') that marks ANY row, only rows marked Delivered are
    returned -- Pending / Scheduled / Cancelled and blank rows are
    ignored; if the status column is entirely blank (or there is none),
    every real row is returned. only_pending=False always returns every
    real row.
    """
    suffix = path.suffix.lower()
    if suffix == ".json":
        data = load_json(path, [])
        if isinstance(data, dict):
            data = data.get("customers", [])
        return [str(c).strip() for c in data if str(c).strip()]

    if suffix in (".xlsx", ".xls"):
        import openpyxl
        wb = openpyxl.load_workbook(str(path), read_only=True, data_only=True)
        rows = [list(r) for r in wb.active.iter_rows(values_only=True)]
    elif suffix == ".csv":
        import csv
        with open(path, encoding="utf-8-sig", newline="") as fh:
            rows = [r for r in csv.reader(fh)]
        width = max((len(r) for r in rows), default=0)
        rows = [r + [""] * (width - len(r)) for r in rows]
    else:  # .txt
        names = []
        for line in path.read_text(encoding="utf-8-sig").splitlines():
            name = line.split(",")[0].strip()
            if name:
                names.append(name)
        return names

    if not rows:
        return []

    header = [str(c).strip().lower() if c is not None else "" for c in rows[0]]

    def _col(*names_: str) -> int | None:
        for want in names_:
            for i, h in enumerate(header):
                if h == want:
                    return i
        return None

    name_idx = _col("customer name")
    if name_idx is None:
        name_idx = 0
        status_idx = None
        key_idx = None
    else:
        status_idx = _col("action", "order status", "status")
        key_idx = _col("filtered #", "filtered#", "filtered", "s/n", "sn")

    if not only_pending:                    # explicit "everything" mode
        names = []
        for row in rows[1:]:
            name = _cell_text(row, name_idx)
            if name:
                names.append(name)
        return names
    work, _ = _select_work_rows(rows[1:], name_idx, status_idx, key_idx)
    return [_cell_text(row, name_idx) for row in work]


def load_config(path: Path | None) -> dict:
    if path is None:
        return {}
    return load_json(path, {}) or {}


class _Tee:
    """Fan one stream's writes out to several (console + client log)."""

    def __init__(self, *streams):
        self._streams = streams

    def write(self, data: str) -> int:
        written = 0
        for stream in self._streams:
            try:
                stream.write(data)
                written = len(data)
            except Exception:                 # noqa: BLE001
                pass
        return written

    def flush(self) -> None:
        for stream in self._streams:
            try:
                stream.flush()
            except Exception:                 # noqa: BLE001
                pass


def _install_job_log(manager: WorkspaceManager, canonical: str) -> Path | None:
    """Tee console output into <client>/state/deliver/deliver.log.

    Every client keeps its ENTIRE consign inside its own folder (state,
    db, events, screens, report, not_found) -- this adds the narrative
    log, so nothing depends on where the operator redirects stdout.
    """
    try:
        paths = manager.client_paths(manager.resolve_client_id(canonical))
        log_path = paths.state_dir / "deliver" / "deliver.log"
        log_path.parent.mkdir(parents=True, exist_ok=True)
        handle = open(log_path, "a", encoding="utf-8", buffering=1)
    except Exception as exc:                  # noqa: BLE001
        print(f"[deliver] warning: per-client job log unavailable: {exc}",
              flush=True)
        return None
    sys.stdout = _Tee(sys.stdout, handle)
    sys.stderr = _Tee(sys.stderr, handle)
    return log_path


# ============================ waits =========================================


def _probe_network() -> bool:
    """doc §20: cheap connectivity probe."""
    try:
        import urllib.request
        with urllib.request.urlopen(NETWORK_PROBE_URL, timeout=4):
            return True
    except Exception:
        return False


def wait_for_network(store: DeliverStore, max_wait_s: int = MAX_NETWORK_WAIT_S) -> None:
    """doc §20: pause + poll until connectivity returns, without consuming
    the row's UI retries."""
    waited = 0
    interval = 5
    while waited < max_wait_s:
        if _probe_network():
            return
        time.sleep(interval)
        waited += interval
        if store.shutdown:
            raise ShutdownRequested("shutdown during network wait")
    raise DeliverError("network", f"no connectivity for {max_wait_s}s",
                       retryable=True)


def wait_for_app_idle(page, timeout_ms: int = 9000) -> None:
    """doc §8: wait for application-specific conditions, not networkidle:
    either a DATA row exists (TABLE_ROW_DATA -- the empty-state row is not a
    row, or this returned instantly on an empty table and callers then read
    a stale view), an explicit empty state exists, or a search response has
    landed."""
    deadline = time.monotonic() + timeout_ms / 1000
    while time.monotonic() < deadline:
        try:
            if page.locator(TABLE_ROW_DATA).count() > 0:
                return
            body_text = page.locator("body").inner_text(timeout=1000)
            if re.search(r"no (orders|results|data)", body_text, re.I):
                return
        except PWError:
            pass
        except Exception:
            return
        page.wait_for_timeout(250)
    # timeout: caller decides (search retry)


def _center(locator, pause_ms: int = 220) -> None:
    """Scrolls the given element to the visual CENTER of the viewport
    (instant jump, then waits for it to settle) before the automation acts on
    it -- so a human watching always sees exactly what's about to be clicked,
    instead of the page sitting still while things change off-screen.

    Best-effort only: if the element can't be measured/scrolled for any
    reason (already detached, mid-animation, etc.), this silently no-ops
    rather than raising -- visual centering is a UX nicety for the human
    watching, never a reason to break the automation flow. The caller's
    own click/hover still runs its normal Playwright auto-scroll-and-wait
    logic immediately after, so correctness never depends on this
    succeeding.
    """
    try:
        # Elements inside dialogs / menus / listboxes / popovers live on
        # position:fixed layers. scrollIntoView() on them cannot move them,
        # it only scrolls the page BEHIND (and makes anchored popovers
        # reposition mid-click), so leave them alone -- Playwright's own
        # click already scrolls when it really has to.
        moved = locator.evaluate(
            """el => new Promise(resolve => {
                if (el.closest('[role="dialog"], [role="alertdialog"], '
                    + '[role="menu"], [role="listbox"], '
                    + '[data-radix-popper-content-wrapper], [cmdk-root]')) {
                    resolve(false);
                    return;
                }
                // 'instant' (not 'smooth'): a smooth scroll runs for several
                // hundred ms on the compositor, so the very next click/hover
                // races it (menus and popovers are anchored to elements that
                // are still sliding) and a page-level CSS `scroll-behavior:
                // smooth` would even turn 'auto' into an animation. The
                // human watching still sees the page jump to the element.
                el.scrollIntoView({block: 'center', inline: 'center',
                                   behavior: 'instant'});
                // Then wait until the element has really stopped moving.
                const box = () => {
                    const r = el.getBoundingClientRect();
                    return r.top + ',' + r.left;
                };
                let last = box(), stable = 0;
                const t0 = performance.now();
                // rAF is paused in a hidden/occluded window: never hang.
                setTimeout(() => resolve(true), 1700);
                const tick = () => {
                    const cur = box();
                    stable = (cur === last) ? stable + 1 : 0;
                    last = cur;
                    if (stable >= 6 || performance.now() - t0 > 1500) {
                        resolve(true);
                    } else {
                        requestAnimationFrame(tick);
                    }
                };
                requestAnimationFrame(tick);
            })""",
            timeout=4000,
        )
        if moved and pause_ms:
            locator.page.wait_for_timeout(pause_ms)
    except Exception:
        pass


def read_tab_count(page, tab) -> int:
    """Badge count of a status tab (e.g. 'Delivered 42'). `tab` may be a
    CSS selector string or an already-resolved Locator."""
    try:
        loc = page.locator(tab).first if isinstance(tab, str) else tab
        text = loc.inner_text(timeout=4000)
        digits = re.sub(r"[^\d]", "", text)
        return int(digits) if digits else 0
    except Exception:
        return 0



# ============================ the CRM driver ================================


class DeliverDriver:
    """Implements the doc §30 worker algorithm with verification hierarchy
    doc §27: Order ID status first, Delivered-tab presence second, counts
    only as a sanity check."""

    def __init__(self, page, store, config: dict, verbose: bool = False):
        self.page = page
        self.store = store
        self.config = config
        self.verbose = verbose
        self.agent = config.get("defaultAgent", DEFAULT_AGENT)
        self.period = config.get("period", DEFAULT_PERIOD)
        self.browser_recoveries = 0
        self.network_recoveries = 0
        self._dumped: set = set()
        # Chip names are config-overridable (plan doc §8 shape).
        self.form_chip = config.get("orderByForms") or FORM_CHIP
        self.filter_chips = tuple(config.get("filterBy") or FILTER_CHIPS)
        # One-line reason for the last non-success outcome; printed by run().
        self.last_detail = ""
        # Short note about the last SUCCESS (e.g. a price overwrite).
        self.last_note = ""
        # clean_name(customer) -> price from the Excel/CSV price column.
        self.prices: dict = {}
        # clean_name(customer) -> [phone key, ...] from the sheet's phone
        # columns; tells two customers who share a name apart (find_row).
        self.phones: dict = {}
        # How the last verification was confirmed: 'row-delivered',
        # 'pending-gone' (fast path) or 'delivered-tab'.
        self.last_verify = ""
        self.overwrite_price = bool(config.get("overwritePrice", True))
        self._store_warned = False
        # fetch/xhr tracking so a search/tab click can be waited on properly.
        self._pending_reqs: dict = {}
        self._req_seq = 0
        self._last_net = time.monotonic()
        self._track_network()

    def _log(self, msg: str) -> None:
        """Verbose-only detail (quiet by default: one line per customer)."""
        if self.verbose:
            print(msg, flush=True)

    def _say(self, msg: str) -> None:
        """Always printed: used only for failure diagnostics."""
        print(msg, flush=True)

    # ---- state-store calls that can never break a customer -------------------
    def _safe_transition(self, rec, state: str, **extra) -> None:
        """rec.transition() with every value reduced to something a SQLite
        parameter can bind (dict/list -> JSON string). A store error is
        reported once and never aborts the flow: by the time SAVE_SUBMITTED
        is recorded the Save has already been clicked, and the CRM
        verification that follows must still run."""
        plain = {k: (json.dumps(v, default=str)
                     if isinstance(v, (dict, list, tuple)) else v)
                 for k, v in extra.items()}
        try:
            rec.transition(state, **plain)
        except Exception as exc:                     # noqa: BLE001
            self._warn_store(state, exc)

    def _safe_checkpoint(self) -> None:
        try:
            self.store.checkpoint()
        except Exception as exc:                     # noqa: BLE001
            self._warn_store("checkpoint", exc)

    def _warn_store(self, what: str, exc: Exception) -> None:
        if not self._store_warned:
            self._store_warned = True
            self._say(f"[deliver] warning: state store rejected '{what}' "
                      f"({type(exc).__name__}: {exc}) -- continuing "
                      "(further store errors are not repeated)")

    # ---- network tracking (search / tab settle) ----------------------------
    def _track_network(self) -> None:
        def _is_api(req) -> bool:
            try:
                return req.resource_type in ("fetch", "xhr")
            except Exception:
                return False

        def _on_request(req) -> None:
            if _is_api(req):
                self._pending_reqs[id(req)] = time.monotonic()
                self._req_seq += 1
                self._last_net = time.monotonic()

        def _on_done(req) -> None:
            if _is_api(req):
                self._pending_reqs.pop(id(req), None)
                self._last_net = time.monotonic()

        try:
            self.page.on("request", _on_request)
            self.page.on("requestfinished", _on_done)
            self.page.on("requestfailed", _on_done)
        except Exception:
            pass

    def _inflight_now(self) -> int:
        cutoff = time.monotonic() - 8.0      # ignore hung/streaming requests
        for key in [k for k, t in self._pending_reqs.items() if t < cutoff]:
            self._pending_reqs.pop(key, None)
        return len(self._pending_reqs)

    def _wait_search_settled(self, seq0: int, min_wait_ms: int = 1500,
                             max_wait_ms: int = 10_000,
                             quiet_ms: int = 700) -> None:
        """Wait until the result of a search / tab click has LANDED.
        wait_for_app_idle() cannot do this: it returns as soon as any row
        exists, which with a full table on screen is instantly (plan doc §6
        #14: wait for the search response, or settle 1500ms).
          * a request started after `seq0`  -> wait until nothing is in
            flight and the network has been quiet for `quiet_ms`;
          * no request ever started         -> settle `min_wait_ms`
            (client-side filter / cached result), then go.
        Hard-capped by `max_wait_ms`."""
        start = time.monotonic()
        while True:
            now = time.monotonic()
            elapsed_ms = (now - start) * 1000
            saw = self._req_seq > seq0
            inflight = self._inflight_now()
            quiet = (now - self._last_net) * 1000 >= quiet_ms
            if saw and inflight == 0 and quiet:
                break
            if not saw and inflight == 0 and elapsed_ms >= min_wait_ms:
                break
            if elapsed_ms >= max_wait_ms:
                self._log("[deliver] search settle hit the "
                          f"{max_wait_ms}ms cap")
                break
            self.page.wait_for_timeout(100)
        self.page.wait_for_timeout(250)      # let React paint the rows

    @staticmethod
    def _clean(text_value: str) -> str:
        return clean_name(text_value)

    # ---- primitives ---------------------------------------------------------
    def _first(self, selector: str, timeout_ms: int = 8000):
        return self.page.locator(selector).first

    def _deadline_left(self, started: float) -> float:
        return PER_ORDER_DEADLINE_S - (time.monotonic() - started)

    @staticmethod
    def _norm(text_value: str) -> str:
        return re.sub(r"\s+", " ", (text_value or "").strip()).lower()

    @staticmethod
    def _rx(*variants: str, label: bool = False):
        """Case/whitespace-tolerant, anchored regex for one or more literal
        spellings. label=True also tolerates a trailing '*' and ':'."""
        alts = [r"\s+".join(re.escape(part) for part in v.split())
                for v in variants if v and v.strip()]
        tail = r"\s*\*?\s*:?\s*$" if label else r"\s*$"
        return re.compile(r"^\s*(?:" + "|".join(alts) + r")" + tail, re.I)

    def _wait_until_enabled(self, locator, timeout_ms: int) -> bool:
        """Poll until a control is enabled (Playwright's own click() would
        block 30s on a disabled control with no useful message)."""
        deadline = time.monotonic() + timeout_ms / 1000
        while True:
            try:
                if locator.is_enabled(timeout=1000):
                    return True
            except PWError:
                pass
            if time.monotonic() >= deadline:
                return False
            self.page.wait_for_timeout(250)

    def _escape(self) -> None:
        try:
            self.page.keyboard.press("Escape")
        except PWError:
            pass

    def _dump_filter_debug(self, tag: str) -> None:
        """Failure diagnostics for the filter bar: what labels / comboboxes
        the page actually has (with enabled state), plus a screenshot. Once
        per tag per driver so a retry loop can't spam."""
        if tag in self._dumped:
            return
        self._dumped.add(tag)
        try:
            info = self.page.evaluate(r"""() => {
                const txt = e => (e.innerText || '').replace(/\s+/g, ' ')
                                                    .trim().slice(0, 40);
                return {
                  viewport: [window.innerWidth, window.innerHeight],
                  labels: Array.from(document.querySelectorAll('label'))
                               .map(txt).slice(0, 20),
                  triggers: Array.from(document.querySelectorAll(
                      'button[role="combobox"], button[aria-haspopup]'))
                      .slice(0, 12).map(b => ({
                        text: txt(b), role: b.getAttribute('role'),
                        popup: b.getAttribute('aria-haspopup'),
                        disabled: b.disabled})),
                };
            }""")
            self._say("[deliver:debug] " + tag + ": "
                      + json.dumps(info, ensure_ascii=True))
        except Exception:
            pass
        try:
            root = getattr(self.store, "root", None)
            out_dir = (Path(root) / "screens") if root else Path("deliver_debug")
            out_dir.mkdir(parents=True, exist_ok=True)
            slug = re.sub(r"[^A-Za-z0-9_.-]+", "_", tag)[:60]
            self.page.screenshot(path=str(out_dir / (slug + ".png")),
                                 full_page=True)
        except Exception:
            pass

    # ---- filters (doc §2.1, idempotent) -----------------------------------
    def ensure_filters(self, client: str) -> str:
        """doc §2.1(a)(b). Period = combobox, exact match only. User = cmdk
        popover: skip `Other` (`All` sentinel), first item of the first
        non-`Other` group (client name preferred)."""
        self._set_period(self.period)
        user = self._pick_crm_user(client)
        self._log(f"[deliver:filters] period={self.period} user={user}")
        return user

    # -- generic persistent combobox select --------------------------------
    def _select_combobox(self, trigger, option_selector: str, pick_fn,
                         timeout_ms: int = 6000, max_attempts: int = 3,
                         label: str = "option", step: str = "filter"):
        """A single open->click on a Radix combobox / listbox option can
        close the popup without the trigger ever actually updating -- the
        click can land while the listbox is still animating in, or the app
        can re-render the trigger a beat after the click event fires.

        This opens the trigger, asks `pick_fn(options_locator)` to choose an
        option, clicks it, then reads the trigger's OWN text back and only
        returns once it actually reflects the pick. If it doesn't, the
        whole open/pick/click cycle is retried (with an Escape in between
        to close any stuck popup) up to `max_attempts` times before
        raising.

        pick_fn(options) -> (option_locator, confirm_text, ...extra) or
        None if nothing selectable was rendered. `confirm_text` is matched
        against the trigger's post-click text (exact, then substring) to
        decide whether the click actually registered. Returns whatever
        pick_fn returned once confirmed.
        """
        last_seen = None
        picked = None
        for attempt in range(1, max_attempts + 1):
            _center(trigger)
            trigger.click()
            options = self.page.locator(option_selector)
            try:
                options.first.wait_for(state="visible", timeout=timeout_ms)
            except PWError:
                self._log(f"[deliver:filters] {label} popover did not open "
                          f"(attempt {attempt})")
                self.page.wait_for_timeout(200)
                continue
            picked = pick_fn(options)
            if picked is None:
                seen = []
                try:
                    for i in range(min(options.count(), 20)):
                        try:
                            seen.append(
                                options.nth(i).inner_text(timeout=1000)
                                .strip())
                        except PWError:
                            continue
                except PWError:
                    pass
                raise DeliverError(
                    step, f"no selectable {label} option rendered "
                    f"(saw {len(seen)} option(s): {seen!r})")
            option, confirm_text = picked[0], picked[1]
            _center(option)
            option.click()
            self.page.wait_for_timeout(250)
            try:
                last_seen = trigger.inner_text(timeout=2000).strip()
            except PWError:
                last_seen = None
            want = (confirm_text or "").strip().lower()
            got = (last_seen or "").strip().lower()
            # Digits-only fallback: package/amount confirm_text is often a
            # bare number (e.g. "10000") while the trigger renders it with
            # currency/commas (e.g. "Premium ₦10,000"), which fails a plain
            # substring check even though the selection did register.
            want_digits = re.sub(r"[^\d]", "", want)
            got_digits = re.sub(r"[^\d]", "", got)
            digit_match = bool(want_digits) and want_digits in got_digits
            if want and got and (got == want or want in got or digit_match):
                return picked
            self._log(f"[deliver:filters] {label} trigger did not confirm "
                      f"'{confirm_text}' (attempt {attempt}, showed "
                      f"'{last_seen}')")
            # Escape ONLY when a popup is really still open: with no popup
            # open, Escape goes to the Dialog underneath and CLOSES it.
            try:
                if self.page.locator(option_selector).first.is_visible():
                    self.page.keyboard.press("Escape")
            except PWError:
                pass
            self.page.wait_for_timeout(200)
        raise DeliverError(step, f"{label} trigger never confirmed "
                           "selection" + (f" (last showed '{last_seen}')"
                                          if last_seen else ""))

    def _set_period(self, period: str) -> None:
        """doc §2.1(a): exact match only (first option is `All Time`)."""
        trigger = self._first(PERIOD_TRIGGER)
        try:
            current = trigger.inner_text(timeout=5000).strip()
        except PWError:
            current = ""
        if current.lower() == period.lower():
            return

        def _pick(options):
            want = re.sub(r"\s+", " ", period).strip().lower()
            for i in range(options.count()):
                option = options.nth(i)
                try:
                    shown = option.inner_text(timeout=1500).strip()
                except PWError:
                    continue
                if re.sub(r"\s+", " ", shown).strip().lower() == want:
                    return (option, shown)
            return None

        self._select_combobox(trigger, 'div[role="option"]', _pick,
                              label=f"Period '{period}'", step="filter")

    # -- User (cmdk popover: doc §2.1(b) + cmdk spec) -----------------------
    @staticmethod
    def _strip_group(label: str) -> str:
        text_value = re.sub(r"\s+", " ", (label or "").strip())
        match = re.match(r"^(Sales Rep|Other|Admin|Manager|Staff)\s+(.*)$",
                         text_value, re.I)
        return (match.group(2) if match else text_value).strip()

    @staticmethod
    def _preferred_users(client: str) -> list:
        raw = (client or "").strip()
        match = re.match(r"^client_(.+?)_[0-9a-f]{6,}$", raw, re.I)
        name = (match.group(1) if match else raw).strip().lower()
        return [name] if name else []

    @staticmethod
    def _user_option_index(options: list, preferred: list):
        first = None
        for index, (value, shown) in enumerate(options):
            name = (DeliverDriver._strip_group(value)
                    or DeliverDriver._strip_group(shown))
            if not name or name.lower() in USER_SENTINELS:
                continue
            if first is None:
                first = index
            if name.lower() in preferred:
                return index
        return first

    def _open_user_popover(self, trigger):
        _center(trigger)
        trigger.click(timeout=10_000)
        for selector in (CMDK_POPOVER, CMDK_POPOVER_FALLBACK):
            popover = self.page.locator(selector).first
            try:
                popover.wait_for(state="visible", timeout=6000)
                return popover
            except PWError:
                continue
        raise DeliverError("filter", "User popover did not open")

    def _user_options(self, popover):
        for selector in (CMDK_ITEM_NOT_OTHER, CMDK_ITEM_SALES_REP, CMDK_ITEM):
            items = popover.locator(selector)
            try:
                count = min(items.count(), 40)
            except PWError:
                continue
            options, handles = [], []
            for i in range(count):
                item = items.nth(i)
                try:
                    value = (item.get_attribute("data-value") or "").strip()
                    shown = item.inner_text(timeout=1500).strip()
                except PWError:
                    continue
                options.append((value, shown))
                handles.append(item)
            if options:
                return options, handles
        return [], []

    def _user_trigger_shows(self, trigger, label: str) -> bool:
        try:
            span = trigger.locator("span").first
            text_value = (span.inner_text(timeout=3000) if span.count()
                          else trigger.inner_text(timeout=3000))
        except PWError:
            return False
        got = re.sub(r"\s+", " ", text_value.strip()).lower()
        want = re.sub(r"\s+", " ", (label or "").strip()).lower()
        return bool(want) and (got == want or got.endswith(want))

    def _pick_crm_user(self, client: str) -> str:
        trigger = self._first(USER_TRIGGER)
        trigger.wait_for(state="visible", timeout=8000)
        # FIX: the CRM keeps User disabled until a "Filter By" chip is
        # applied. Wait for it to be enabled (one chip re-apply if not)
        # instead of a 30s blind click that dies with "element is not
        # enabled".
        if not self._wait_until_enabled(trigger, USER_ENABLE_TIMEOUT_MS):
            self._say("[deliver:filters] User filter is still disabled -- "
                      "re-applying the 'Filter By' chips once")
            self.ensure_form_chips()
            if not self._wait_until_enabled(trigger, USER_ENABLE_TIMEOUT_MS):
                self._dump_filter_debug("user_disabled")
                have = [c for c in self.filter_chips
                        if self._chip_present(c)]
                raise DeliverError(
                    "filter",
                    "User filter is still disabled -- no 'Filter By' chip "
                    "could be applied (Added By / Assigned By present: "
                    f"{have or 'none'}). See the [deliver:debug] lines above")
        preferred = self._preferred_users(client)
        label = ""
        for attempt in (1, 2):
            popover = self._open_user_popover(trigger)
            options, handles = self._user_options(popover)
            index = self._user_option_index(options, preferred)
            if index is None:
                raise DeliverError(
                    "filter", "no selectable User option (only the `Other`/"
                              "`All` sentinel was rendered)")
            label = (self._strip_group(options[index][0])
                     or self._strip_group(options[index][1]))
            _center(handles[index])
            handles[index].click()
            self.page.wait_for_timeout(300)
            if self._user_trigger_shows(trigger, label):
                return label
            self._log("[deliver:filters] user trigger did not confirm '"
                      + label + "' (attempt " + str(attempt) + ")")
        raise DeliverError("filter", "User trigger never confirmed '"
                           + label + "'")

    # -- chips (doc §2.1(c)(d), idempotent) ---------------------------------
    @staticmethod
    def _chip_variants(chip: str) -> tuple:
        variants = CHIP_ALIASES.get(chip, (chip,))
        return (chip,) + tuple(v for v in variants if v != chip)

    def _group_chips(self, group_label: str) -> tuple:
        if group_label == "Order by Forms":
            return (self.form_chip,)
        return self.filter_chips

    def _chip_present(self, label: str) -> bool:
        """A chip is a <span> rendered INSIDE the group's trigger <button>
        (plan doc §2.1 c/d). Case/whitespace tolerant, alias aware
        ("Assigned To" == "Assigned By"); ignores same-text items inside an
        open popup/listbox."""
        try:
            chips = self.page.locator("button").filter(
                has=self.page.locator("span").filter(
                    has_text=self._rx(*self._chip_variants(label))))
            for i in range(min(chips.count(), 6)):
                in_popup = chips.nth(i).evaluate(
                    "e => !!e.closest('[role=\"dialog\"], [role=\"listbox\"], "
                    "[role=\"menu\"], [cmdk-root]')")
                if not in_popup:
                    return True
            return False
        except PWError:
            return False

    def _group_label(self, group_label: str):
        """The group's caption element, or None. Prefers a real <label>;
        falls back to any non-popup element whose text is the caption."""
        rx = self._rx(*GROUP_LABEL_ALIASES.get(group_label, (group_label,)),
                      label=True)
        try:
            labels = self.page.locator("label").filter(has_text=rx)
            if labels.count() > 0:
                return labels.first
            loose = self.page.get_by_text(rx)
            for i in range(min(loose.count(), 6)):
                el = loose.nth(i)
                in_popup = el.evaluate(
                    "e => !!e.closest('[role=\"option\"], "
                    "[role=\"dialog\"], [role=\"menu\"]')")
                if not in_popup:
                    return el
        except PWError:
            pass
        return None

    def _trigger_from_chip(self, group_label: str):
        """If any chip of this group is already rendered, the trigger IS the
        button that contains it (plan doc §2.1 c/d) -- no label needed."""
        for chip in self._group_chips(group_label):
            if self._chip_present(chip):
                return self.page.locator("button").filter(
                    has=self.page.locator("span").filter(
                        has_text=self._rx(*self._chip_variants(chip)))).first
        return None

    def _trigger_near_label(self, label):
        """label -> its OWN trigger. Closest enclosing cell first, and never
        cross into a container that holds more than one <label> (that is the
        filter grid -- the old (2, 3, 1) ancestor order escaped into it and
        returned the Period trigger). Returns (locator, how) or None."""
        try:
            target_id = label.get_attribute("for", timeout=1000)
        except PWError:
            target_id = None
        if target_id:
            target = self.page.locator('[id="' + target_id + '"]').first
            try:
                if (target.count() > 0
                        and target.evaluate("e => e.tagName") == "BUTTON"):
                    return target, "label-for"
            except PWError:
                pass
        for kinds in (('button[role="combobox"]', 'button[aria-haspopup]'),
                      ("button",)):
            for depth in range(1, 6):
                container = label.locator(
                    "xpath=ancestor::div[" + str(depth) + "]")
                try:
                    if container.count() == 0:
                        break
                    if container.locator("label").count() > 1:
                        break              # crossed into the filter grid
                except PWError:
                    break
                for kind in kinds:
                    found = container.locator(kind)
                    try:
                        if found.count() > 0:
                            return found.first, ("ancestor[" + str(depth)
                                                 + "] " + kind)
                    except PWError:
                        continue
        for kind in ('button[@role="combobox"]', "button[@aria-haspopup]",
                     "button"):
            nxt = label.locator("xpath=following::" + kind + "[1]")
            try:
                if nxt.count() > 0:
                    return nxt.first, "following::" + kind
            except PWError:
                continue
        return None

    def _group_trigger(self, group_label: str):
        """Returns (trigger_locator, how) or None."""
        anchored = self._trigger_from_chip(group_label)
        if anchored is not None:
            return anchored, "chip"
        label = self._group_label(group_label)
        if label is None:
            return None
        return self._trigger_near_label(label)

    def _popup_for_trigger(self, timeout_ms: int = 5000):
        popup = self.page.locator(POPUP_SELECTOR).last
        popup.wait_for(state="visible", timeout=timeout_ms)
        return popup

    def _find_option(self, popup, chip: str):
        """Exact-text option preferred, substring second. Returns
        (option_or_None, texts_seen)."""
        wants = [self._norm(v) for v in self._chip_variants(chip)]
        items = popup.locator(OPTION_SELECTORS)
        exact = partial = None
        seen: list = []
        try:
            count = min(items.count(), 40)
        except PWError:
            count = 0
        for i in range(count):
            item = items.nth(i)
            try:
                shown = self._norm(item.inner_text(timeout=1000))
            except PWError:
                continue
            if not shown:
                continue
            seen.append(shown)
            if shown in wants:
                exact = item
                break
            if partial is None and any(w in shown for w in wants):
                partial = item
        return (exact or partial), seen

    @staticmethod
    def _option_selected(option) -> bool:
        """True if a multi-select item is already ticked (so a retry does
        not click it again and UN-tick it)."""
        try:
            return bool(option.evaluate(
                """e => e.getAttribute('aria-selected') === 'true'
                     || e.getAttribute('aria-checked') === 'true'
                     || e.getAttribute('data-state') === 'checked'
                     || !!e.querySelector('[data-state="checked"], '
                                          + '[aria-checked="true"], '
                                          + 'input:checked')"""))
        except PWError:
            return False

    def _wait_for_chip(self, chip: str, timeout_ms: int) -> bool:
        deadline = time.monotonic() + timeout_ms / 1000
        while True:
            if self._chip_present(chip):
                return True
            if time.monotonic() >= deadline:
                return False
            self.page.wait_for_timeout(150)

    def _close_popups(self) -> None:
        try:
            if self.page.locator(POPUP_OPEN_VISIBLE).count() > 0:
                self._escape()
                self.page.wait_for_timeout(150)
        except PWError:
            pass

    def ensure_form_chips(self) -> bool:
        """Applies 'combo set' + 'Added By' + 'Assigned By' when missing.
        Returns True when at least one 'Filter By' chip is present (that is
        what unlocks the User filter)."""
        self._wait_for_filters_ready()
        for group_label, chips in (("Order by Forms", (self.form_chip,)),
                                   ("Filter By", self.filter_chips)):
            for chip in chips:
                if self._chip_present(chip):
                    continue
                if not self._apply_chip(group_label, chip):
                    print("[deliver] warning: filter chip '" + chip
                          + "' not present under '" + group_label
                          + "' -- continuing", flush=True)
        return any(self._chip_present(c) for c in self.filter_chips)

    def _wait_for_filters_ready(self) -> None:
        """Wait for the filter bar itself to exist before touching any chip
        or combobox in it (it renders as a second wave after 'Add Order').
        Uses the Period trigger as the cheapest reliable "filter bar
        mounted" signal, with one reload+retry, mirroring
        _confirm_orders_page.
        """
        trigger = self._first(PERIOD_TRIGGER)
        try:
            trigger.wait_for(state="visible", timeout=FILTERS_READY_TIMEOUT_MS)
            return
        except PWError:
            self._log("[deliver:filters] filter bar not ready -- "
                      "reloading and retrying")
        self.page.reload(wait_until="commit")
        _confirm_orders_page(self.page)
        trigger = self._first(PERIOD_TRIGGER)
        trigger.wait_for(state="visible", timeout=FILTERS_READY_TIMEOUT_MS)

    def _apply_chip(self, group_label: str, chip: str) -> bool:
        """Open the group's OWN trigger, tick `chip` in its popup, Confirm,
        and only return True once the chip is actually rendered."""
        for attempt in range(1, 4):
            found = self._group_trigger(group_label)
            if found is None:
                self._say("[deliver:filters] cannot find the '" + group_label
                          + "' filter (no matching <label> / chip on the "
                          "page; wanted " + repr(self._group_chips(group_label))
                          + ")")
                self._dump_filter_debug("group_" + group_label)
                return False
            trigger, how = found
            self._log("[deliver:filters] '" + group_label + "' trigger via "
                      + how)
            try:
                if not self._wait_until_enabled(trigger, 6000):
                    raise DeliverError(
                        "chip", "'" + group_label + "' trigger is disabled")
                _center(trigger)
                trigger.click(timeout=8000)
                popup = self._popup_for_trigger()
                option, seen = self._find_option(popup, chip)
                if option is None:
                    self._say("[deliver:filters] option '" + chip
                              + "' (also tried "
                              + repr(self._chip_variants(chip)[1:])
                              + ") not found under '" + group_label
                              + "' (trigger via " + how
                              + "); popup shows: " + repr(seen)
                              + " -- set `filterBy` in the config to one of"
                              " these names")
                    self._dump_filter_debug("option_" + chip)
                    raise DeliverError("chip", "option '" + chip
                                       + "' not in popup")
                if not self._option_selected(option):
                    _center(option)
                    option.click(timeout=6000)
                    self.page.wait_for_timeout(200)
                confirm = self.page.get_by_role("button",
                                                name=CONFIRM_BUTTON_RX)
                if confirm.count() and confirm.first.is_visible():
                    _center(confirm.first)
                    confirm.first.click(timeout=6000)
                    self.page.wait_for_timeout(250)
            except (PWError, DeliverError) as exc:
                self._log("[deliver:filters] chip '" + chip + "' attempt "
                          + str(attempt) + " failed: " + str(exc)[:160])
                self._escape()
                self.page.wait_for_timeout(200)
                continue
            if self._wait_for_chip(chip, CHIP_CONFIRM_TIMEOUT_MS):
                self._close_popups()
                return True
            self._log("[deliver:filters] chip '" + chip + "' under '"
                      + group_label + "' did not render (attempt "
                      + str(attempt) + ")")
            self._escape()
            self.page.wait_for_timeout(200)
            if self._wait_for_chip(chip, 1000):
                return True
        self._dump_filter_debug("chip_" + chip)
        return False

    def _search_button(self):
        """Plan doc §2.1 e: role=button name /^Search$/ first; then the
        icon+text fallback; the old loose has-text selector last."""
        for loc in (self.page.get_by_role(
                        "button", name=re.compile(r"^\s*Search\s*$", re.I)),
                    self.page.locator(SEARCH_BUTTON_FALLBACK)):
            try:
                if loc.count() > 0:
                    return loc.first
            except PWError:
                continue
        return self._first(SEARCH_BUTTON_LEGACY)

    def submit_search(self) -> None:
        btn = self._search_button()
        _center(btn)
        btn.click()
        self.page.wait_for_timeout(800)
        wait_for_app_idle(self.page)

    def wait_for_orders_ready(self, timeout_ms: int = 20_000) -> bool:
        """Make sure the orders LIST has rendered before any tab badge or
        row is read (called right after submit_search()).

        FIX (this revision, "the run that read pending=0 delivered=0"): the
        badges are only painted once the filtered list has come back, so
        reading them too early yielded 0/0 and every later search then
        reported "No orders match your filters" (a false NOT_FOUND for a
        customer who was sitting in Pending the whole time). Waits for a
        data row, the app's empty-state text or the list footer, and
        re-clicks Search once if none of them ever shows up.
        """
        deadline = time.monotonic() + timeout_ms / 1000
        while time.monotonic() < deadline:
            try:
                if self.page.locator(TABLE_ROW_DATA).count() > 0:
                    return True
                if self._empty_state_text() or self._visible_tab():
                    return True
            except PWError:
                pass
            self.page.wait_for_timeout(250)
        self._log("[deliver] the orders list never confirmed as loaded -- "
                  "clicking Search again")
        try:
            seq0 = self._req_seq
            self.submit_search()
            self._wait_search_settled(seq0, min_wait_ms=1500)
        except PWError:
            pass
        return self.page.locator(TABLE_ROW_DATA).count() > 0

    # ---- tabs (doc 2.2: always click for a fresh load) ----------------------
    def _tab(self, name: str):
        """Plan doc §2.2 F: strict `^Name\\s*\\d*$` first (so a tab like
        'Not Delivered' can never win a has-text substring match); the old
        has-text selector as fallback."""
        strict = self.page.locator(TAB_BASE).filter(
            has_text=re.compile(r"^\s*" + re.escape(name) + r"\s*\d*\s*$",
                                re.I))
        try:
            if strict.count() > 0:
                return strict.first
        except PWError:
            pass
        return self._first(PENDING_TAB if name == "Pending"
                           else DELIVERED_TAB)

    def _visible_tab(self) -> str:
        """Which status tab the table is ACTUALLY showing: 'Pending' /
        'Delivered', or '' when that footer text isn't rendered.

        FIX (this revision, "the Delivered tab showed the Pending row"):
        clicking a tab and settling is not proof the tab switched -- a
        slow/absent lazy fetch left the OTHER tab's rows on screen, and
        reading those could mark a still-Pending order as ALREADY_DELIVERED
        in the state store without ever delivering it. The list footer
        ('Showing 1-1 of 1 match in Pending' / '1 match in Pending') is the
        app's own statement of which tab those rows belong to.
        """
        try:
            body = self.page.locator("body").inner_text(timeout=2000)
        except PWError:
            return ""
        found = re.findall(r"match(?:es)?\s+in\s+(Pending|Delivered)", body,
                           re.I)
        return found[-1].title() if found else ""

    def _open_tab(self, name: str) -> int:
        """Click a status tab and make sure the table really switched to it
        (see _visible_tab): one re-click + re-settle when the footer still
        names the other tab, then refuse (instead of reading the wrong
        tab's rows) if it still won't switch. Returns the badge count.

        Speed: when the footer already names this tab the click is skipped --
        the per-customer search forces a fresh query anyway, so the extra
        tab round trip only cost time.
        """
        if self._visible_tab() == name:
            self._log(f"[deliver] already on the {name} tab -- skipping the "
                      "click")
            return read_tab_count(self.page, self._tab(name))
        seen = ""
        for attempt in (1, 2):
            tab = self._tab(name)
            _center(tab)
            seq0 = self._req_seq
            tab.click()
            self._wait_search_settled(seq0,
                                      min_wait_ms=900 if attempt == 1
                                      else 1500)
            wait_for_app_idle(self.page)
            seen = self._visible_tab()
            if seen == name or not seen:
                break
            self._log(f"[deliver] the {name} tab still shows {seen} "
                      f"(attempt {attempt}) -- clicking it again")
        if seen and seen != name:
            raise DeliverError(
                "tab", f"clicked the {name} tab but the table still shows "
                       f"{seen} -- refusing to read the wrong tab's rows")
        return read_tab_count(self.page, self._tab(name))

    def open_pending_tab(self) -> int:
        return self._open_tab("Pending")

    def open_delivered_tab(self) -> int:
        return self._open_tab("Delivered")

    # ---- search (doc §8/§9) ---------------------------------------------------
    def search_customer(self, name: str) -> int:
        box = self._first(QUICK_SEARCH)
        try:
            box.wait_for(state="visible", timeout=6000)
        except PWTimeoutError:
            box = self._first(QUICK_SEARCH_FALLBACK)
            box.wait_for(state="visible", timeout=6000)
        _center(box)
        box.click()
        box.fill("")
        box.press_sequentially(name[:60], delay=25)
        seq0 = self._req_seq
        box.press("Enter")
        # FIX: wait for the filtered result to LAND. wait_for_app_idle()
        # alone returns instantly when the (stale) full list is on screen.
        self._wait_search_settled(seq0)
        wait_for_app_idle(self.page)
        return self.page.locator(TABLE_ROW_DATA).count()

    def _search_box_value(self) -> str:
        """What the quick-search box holds right now ('' if unreadable)."""
        try:
            return self._first(QUICK_SEARCH).input_value(timeout=2000).strip()
        except PWError:
            return ""

    def _search_box_holds(self, name: str) -> bool:
        """True when the quick-search box really holds this customer's name.

        This is the guard that turns 'the table shows 0 rows' into 'the row
        moved' -- rather than 'the search never landed / the box lost its
        text', which must NOT be read as success.
        """
        typed = self._clean(self._search_box_value())
        wanted = self._clean(name)
        return bool(typed) and (typed == wanted[:60]
                                or wanted.startswith(typed))

    def clear_search(self) -> None:
        """Tab badges are filtered by the quick-search text, so clear it
        before reading a count."""
        box = self._first(QUICK_SEARCH)
        try:
            box.wait_for(state="visible", timeout=4000)
        except PWError:
            box = self._first(QUICK_SEARCH_FALLBACK)
        try:
            if box.input_value(timeout=2000) == "":
                return
        except PWError:
            pass
        _center(box)
        box.click()
        box.fill("")
        seq0 = self._req_seq
        box.press("Enter")
        self._wait_search_settled(seq0)

    @staticmethod
    def _name_in_cell(cell) -> str:
        """Customer name from the Customer Name cell.

        FIX (this revision, "NOT_FOUND for a customer the Pending table DOES
        show"): the name is rendered as one `span.block` PER LINE (see
        join_name_parts), so reading only `.first` truncated it -- the real
        row was on screen, the Excel name "Oladunni folasade Ramat" was
        compared against "Oladunni folasade", the exact match failed and the
        old whole-word fallback only ever looked the other way round.
        ALL blocks are joined now.
        """
        parts = []
        try:
            blocks = cell.locator("span.block")
            count = blocks.count()
            if count > 4:                 # a name cell never carries more
                count = 4
            parts = [blocks.nth(i).inner_text(timeout=1500)
                     for i in range(count)]
        except PWError:
            parts = []
        if parts:
            return join_name_parts(parts)
        # fallback: the name WRAPPER (the `span` that isn't the timestamp),
        # whose inner text carries the name lines for any layout
        try:
            wrap = cell.locator("div.font-medium > span:not(.mono)").first
            if wrap.count() > 0:
                return join_name_parts(
                    wrap.inner_text(timeout=1500).split("\n"))
        except PWError:
            pass
        return cell.inner_text(timeout=2000).split("\n")[0].strip()

    def _cell_name(self, row) -> str:
        try:
            return self._name_in_cell(
                row.locator("td").nth(CUSTOMER_CELL_INDEX))
        except PWError:
            return ""

    def _empty_state_text(self) -> str:
        """The app's own empty-state sentence (e.g. 'No orders match your
        filters'), or '' when the list does have rows."""
        try:
            body = self.page.locator("body").inner_text(timeout=1500)
        except PWError:
            return ""
        match = re.search(r"no (?:orders|results|data)[^\n]{0,40}", body,
                          re.I)
        return match.group(0).strip() if match else ""

    def _table_snapshot(self, limit: int = 6):
        """(row_count, first customer names, empty-state text) -- what the
        table ACTUALLY shows right now, for NOT_FOUND diagnostics. Only DATA
        rows are counted (TABLE_ROW_DATA), so an empty result reads 0 and is
        no longer reported as "1 row(s) but none match"."""
        try:
            rows = self.page.locator(TABLE_ROW_DATA)
            count = rows.count()
            names = [self._cell_name(rows.nth(i))
                     for i in range(min(count, limit))]
        except PWError:
            return 0, [], ""
        return count, names, self._empty_state_text()

    @staticmethod
    def _fmt_snapshot(snap) -> str:
        count, names, empty = snap
        text_value = f"{count} row(s)"
        if names:
            text_value += " " + repr(names) + ("..." if count > len(names)
                                                else "")
        if empty:
            text_value += f" [{empty}]"
        return text_value

    def _search_and_find(self, name: str, phones=None):
        """Search, then look for the row. If the table still has rows but none
        is this customer, the result may not have refreshed (or an older,
        slower response overwrote it) -- search once more before giving up.
        `phones` is passed to find_row() so same-named customers are told
        apart. Returns (row_or_None, snapshot)."""
        snap = (0, [], "")
        for attempt in (1, 2):
            self.search_customer(name)
            row = self.find_row(name, phones)
            snap = self._table_snapshot()
            if row is not None:
                return row, snap
            if snap[0] == 0:
                break                       # explicit empty result
            # Print WHAT the table showed: a name-shape difference (the CRM
            # holding only part of the name) is then visible in the log.
            self._log(f"[deliver] {name}: table shows {snap[0]} row(s) "
                      f"{snap[1]!r} but none match -- re-searching "
                      f"(attempt {attempt})")
        return None, snap

    # ---- row / orderId / status (doc §2/§10) ---------------------------------
    @staticmethod
    def _phones_in_cell(cell) -> list:
        """Phone number(s) in a Contact cell: the `tel:` and `wa.me` links
        (which can be different numbers), else the cell's visible text."""
        hrefs = []
        try:
            hrefs = cell.locator("a").evaluate_all(
                "els => els.map(e => e.getAttribute('href') || '')")
        except PWError:
            hrefs = []
        phones = phones_from_hrefs(hrefs)
        if phones:
            return phones
        try:                        # no links rendered: read the raw text
            text = cell.inner_text(timeout=2000)
        except PWError:
            return []
        return phone_keys(re.findall(r"\+?\d[\d\s()-]{7,}", text))

    def _row_phones(self, cells) -> list:
        try:
            return self._phones_in_cell(cells.nth(CONTACT_CELL_INDEX))
        except PWError:
            return []

    def find_row(self, name: str, phones=None):
        """The row for this customer.

        Exact customer-name match first (whitespace/case-insensitive, plan
        doc §2.4 'exact'). When SEVERAL rows carry that exact name (the CRM
        allows a name to repeat), the Contact number(s) decide: the sheet's
        phone/WhatsApp (load_customer_phones) is compared against each row's
        Contact cell and the matching row wins. If no row's phone matches,
        the FIRST row is used -- the CRM's own order for that name -- and,
        when more than one row was on screen, that is reported.

        The only fallback is a GUARDED partial-name match, accepted only
        when exactly one row on screen qualifies ('Oladunni folasade' for
        the sheet's 'Oladunni folasade Ramat', or the other way round).
        Never a bare substring and never a guess between two candidates:
        this moves real orders.
        """
        want = self._clean(name)
        wanted_phones = phone_keys(phones)
        rows = self.page.locator(TABLE_ROW_DATA)
        n = rows.count()
        exact = []
        candidates = []
        for i in range(min(n, 20)):
            row = rows.nth(i)
            try:
                cells = row.locator("td")
                if cells.count() < 6:
                    continue
                shown = self._clean(
                    self._name_in_cell(cells.nth(CUSTOMER_CELL_INDEX)))
            except PWError:
                continue
            if shown == want:
                if not wanted_phones:
                    return row                  # first exact row wins
                exact.append((row, cells))
                continue
            if len(candidates) < 2 and is_name_candidate(want, shown):
                candidates.append((row, shown))
        if exact:
            return self._pick_by_phone(name, exact, wanted_phones)
        if len(candidates) == 1:
            row, shown = candidates[0]
            self._log(f"[deliver] partial name match: '{name}' -> CRM row "
                      f"shows '{shown}' (only candidate on screen)")
            return row
        if len(candidates) > 1:
            self._say(f"[deliver] '{name}': {len(candidates)} rows could "
                      f"match by name {[c[1] for c in candidates]!r} -- not "
                      "guessing, treating as no match")
        return None

    def _pick_by_phone(self, name: str, exact: list, wanted: list):
        """Rows that carry the exact same name: Contact numbers decide."""
        seen: list = []
        for row, cells in exact:
            row_phones = self._row_phones(cells)
            for phone in row_phones:
                if phone not in seen:
                    seen.append(phone)
            if phone_matches(row_phones, wanted):
                if len(exact) > 1:
                    self._log(f"[deliver] {name}: {len(exact)} rows share "
                              f"this name -- picked the one whose Contact "
                              f"matches the sheet ({wanted[0]})")
                return row
        if len(exact) > 1:
            self._say(f"[deliver] {name}: {len(exact)} rows share this name "
                      f"and none matches the sheet phone(s) {wanted!r} "
                      f"(Contact showed {seen!r}) -- using the first row")
        else:
            self._log(f"[deliver] {name}: row Contact {seen!r} does not "
                      f"match the sheet phone(s) {wanted!r} -- same name, "
                      "continuing")
        return exact[0][0]

    def read_row(self, row) -> dict:
        cells = row.locator("td")
        info = {
            "orderId": "",
            "status": "",
            "amount": 0,
            "customer": "",
            "phone": "",
            "phones": [],
        }
        try:
            info["customer"] = self._name_in_cell(
                cells.nth(CUSTOMER_CELL_INDEX))
        except PWError:
            pass
        try:
            phones = self._phones_in_cell(cells.nth(CONTACT_CELL_INDEX))
            info["phones"] = phones
            info["phone"] = phones[0] if phones else ""
        except PWError:
            pass
        try:
            info["orderId"] = cells.nth(2).inner_text(timeout=2000).strip()
        except PWError:
            pass
        try:
            info["status"] = cells.nth(STATUS_CELL_INDEX).inner_text(
                timeout=2000).strip().split("\n")[0].strip()
        except PWError:
            pass
        try:
            product_text = cells.nth(8).inner_text(timeout=2000)
            # Plan doc §2.8 b: prefer the labeled `Amount: ₦N`; only fall
            # back to the first ₦ figure when no label is present.
            m = (AMOUNT_LABELED_RE.search(product_text)
                 or AMOUNT_RE.search(product_text))
            if m:
                info["amount"] = int(m.group(1).replace(",", ""))
        except PWError:
            pass
        return info


    # ---- menu -> Delivered modal (doc §11/§12) -------------------------------
    def open_move_to_delivered(self, row, started: float) -> None:
        trigger = row.locator(ROW_MENU_TRIGGER).first
        _center(trigger)
        trigger.click()
        menu = self._first(OPEN_MENU)
        menu.wait_for(state="visible", timeout=6000)
        move = self._first('div[role="menuitem"]:has-text("Move to status")')
        _center(move)
        move.hover()
        self._first(SUBMENU).wait_for(state="visible", timeout=6000)
        delivered = self.page.locator(
            f'{SUBMENU} div[role="menuitem"]').filter(
            has_text=re.compile(r"^Delivered\s*$")).first
        _center(delivered)
        delivered.click()
        dialog = self.page.locator(
            f'{MODAL}:has(h2:text-is("{MODAL_TITLE}"))').first
        dialog.wait_for(state="visible", timeout=8000)
        if self._deadline_left(started) <= 0:
            raise WatchdogTimeout("modal open exceeded deadline")

    # ---- modal fields (doc §12-§15) -------------------------------------------
    def _modal_trigger(self, dialog, index: int, caption_rx: str):
        """Modal select trigger: plan doc P (`button[role=combobox]` nth) and,
        because several triggers on this CRM carry NO role (aria-haspopup
        only), a label-anchored fallback."""
        combos = dialog.locator('button[role="combobox"]')
        try:
            if combos.count() > index:
                return combos.nth(index)
        except PWError:
            pass
        try:
            label = dialog.locator("label").filter(
                has_text=re.compile(caption_rx, re.I)).first
            if label.count() > 0:
                found = self._trigger_near_label(label)
                if found is not None:
                    self._log("[deliver] modal trigger via " + found[1])
                    return found[0]
        except PWError:
            pass
        return combos.nth(index)      # let Playwright raise a clear error

    def _pick_agent(self, dialog) -> None:
        """Persistent select + trigger-text confirmation (see
        _select_combobox) -- a click on the Agent option used to be
        trusted blindly, so a click that didn't register left the modal
        with no agent selected and the failure only surfaced much later
        (Save disabled, or a downstream field never populating)."""
        trigger = self._modal_trigger(dialog, 0, r"select from|agent")

        def _pick(options):
            n = options.count()
            exact = None
            fallback = None
            for i in range(n):
                text = options.nth(i).inner_text(timeout=1500).strip()
                if fallback is None:
                    fallback = (options.nth(i), text)
                if text.lower() == self.agent.lower():
                    exact = (options.nth(i), text)
                    break
            if exact is not None:
                return exact
            if fallback is not None:
                print(f"[deliver] agent fallback used -> {fallback[1]}",
                      flush=True)      # doc §12 fallback, logged
                return fallback
            return None

        self._select_combobox(
            trigger,
            'div[role="option"], div[role="listbox"] div[role="option"]',
            _pick, label="Agent", step="agent")

    def _pick_package(self, dialog, expected_amount: int) -> dict:
        """doc §13: exact, else smallest >= expected, else first + warn.
        Persistent select + trigger-text confirmation (see
        _select_combobox) -- previously the click was trusted blindly and
        only caught much later (and only indirectly) by
        _total_amount_ok() failing to populate."""
        trigger = self._modal_trigger(dialog, 1, r"select package|package")
        info: dict = {}

        def _pick(options):
            n = options.count()
            parsed = []
            for i in range(n):
                text = options.nth(i).inner_text(timeout=1500)
                m = AMOUNT_RE.search(text)
                amt = int(m.group(1).replace(",", "")) if m else None
                parsed.append((options.nth(i), amt, text.strip()[:50]))
            exact = next(((o, a, t) for o, a, t in parsed
                          if a == expected_amount and expected_amount > 0),
                         None)
            ge = sorted(((o, a, t) for o, a, t in parsed
                         if a is not None and expected_amount
                         and a >= expected_amount), key=lambda x: x[1])
            chosen = exact or (ge[0] if ge else None) or (
                parsed[0] if parsed else None)
            if chosen is None:
                return None
            option, amt, text = chosen
            info["expectedAmount"] = expected_amount
            info["selectedPackageAmount"] = amt
            info["packageFallback"] = exact is None
            info["packageLabel"] = text
            confirm_text = str(amt) if amt is not None else text[:20]
            return (option, confirm_text)

        self._select_combobox(
            trigger,
            'div[role="option"], div[role="listbox"] div[role="option"]',
            _pick, label="Package", step="package")
        if not info:
            raise DeliverError("package", "no package options rendered")
        return info

    def _total_amount_ok(self, dialog) -> bool:
        try:
            value = dialog.locator('input[type="number"]').first.input_value(
                timeout=4000)
            return bool(value) and float(value) > 0
        except Exception:
            return False


    # ---- save + verify (doc §15/§16) -------------------------------------------
    def _assert_modal_open(self, dialog, after: str) -> None:
        """The dialog must still be there after every field. If it isn't,
        say so right away instead of failing later on a detached element."""
        try:
            if dialog.count() > 0:
                return
        except PWError:
            return
        note = self._visible_alerts()
        raise DeliverError(
            "modal", f"the 'Mark order as Delivered' modal closed "
            f"unexpectedly after the {after} step"
            + (f"; page says: {note}" if note else ""))

    def _save_button(self, dialog):
        """The Save button INSIDE the dialog (last match): exact role+name
        first, then the exact-text and `bg-primary` variants."""
        for loc in (dialog.get_by_role(
                        "button", name=re.compile(r"^\s*Save\s*$", re.I)),
                    dialog.locator('button:text-is("Save")'),
                    dialog.locator('button.bg-primary:has-text("Save")')):
            try:
                if loc.count() > 0:
                    return loc.last
            except PWError:
                continue
        return dialog.get_by_role("button", name="Save").last

    def _modal_state(self, dialog) -> str:
        """One line describing what the modal currently holds."""
        def _txt(loc) -> str:
            try:
                return loc.inner_text(timeout=1000).strip().replace(
                    "\n", " ")[:60]
            except PWError:
                return "?"
        parts = []
        try:
            parts.append("agent=" + repr(_txt(
                self._modal_trigger(dialog, 0, r"select from|agent"))))
            parts.append("package=" + repr(_txt(
                self._modal_trigger(dialog, 1, r"select package|package"))))
            parts.append("total=" + repr(dialog.locator(
                'input[type="number"]').first.input_value(timeout=1000)))
        except PWError:
            pass
        try:
            save = self._save_button(dialog)
            parts.append("save=" + ("enabled" if save.is_enabled(timeout=1000)
                                    else "DISABLED"))
        except PWError:
            pass
        note = self._visible_alerts()
        if note:
            parts.append("page says: " + note)
        return ", ".join(parts)

    def _wait_popups_closed(self, timeout_ms: int = 3000) -> None:
        """A select popup that is still closing can swallow the Save click."""
        deadline = time.monotonic() + timeout_ms / 1000
        selector = '[role="listbox"]:visible, [cmdk-root]:visible'
        while time.monotonic() < deadline:
            try:
                if self.page.locator(selector).count() == 0:
                    return
            except PWError:
                return
            self.page.wait_for_timeout(150)
        try:                                   # still open: close only that
            if self.page.locator(selector).count() > 0:
                self.page.keyboard.press("Escape")
                self.page.wait_for_timeout(250)
        except PWError:
            pass

    @staticmethod
    def _same_amount(text_value: str, price) -> bool:
        digits = re.sub(r"[^\d.]", "", (text_value or "").replace(",", ""))
        try:
            return abs(float(digits) - float(price)) < 0.005
        except ValueError:
            return False

    def _apply_price(self, dialog, price, source: str) -> dict:
        """Make the Total Amount field equal `price`.
        No Backspace / Delete (the form validates on every keystroke and
        races on the empty intermediate state): the field is focused and its
        whole content SELECTED, then the price is inserted in ONE paste-style
        input event that replaces the selection. Verified after a settle
        pause, and re-checked once more before returning."""
        field = dialog.locator('input[type="number"]').first
        try:
            before = field.input_value(timeout=4000)
        except PWError:
            before = ""
        info = {"formTotalBefore": before, "targetPrice": price,
                "priceSource": source, "priceOverwritten": False}
        if self._same_amount(before, price):
            return info
        want = str(int(price)) if float(price) == int(price) else str(price)
        shown = before
        for attempt in (1, 2, 3):
            field.click(timeout=5000)
            if attempt < 3:
                field.select_text(timeout=3000)
                self.page.keyboard.insert_text(want)      # replaces selection
            else:
                field.fill(want)                          # last resort
            self.page.wait_for_timeout(500)               # validation settles
            try:
                shown = field.input_value(timeout=2000)
            except PWError:
                shown = ""
            if self._same_amount(shown, price):
                self.page.wait_for_timeout(400)           # ...and stays put
                try:
                    shown = field.input_value(timeout=2000)
                except PWError:
                    shown = ""
                if self._same_amount(shown, price):
                    info["priceOverwritten"] = True
                    return info
        raise DeliverError(
            "price", f"could not set Total Amount to {want} "
            f"(form total was '{before}', now '{shown}')")

    def fill_and_save(self, info: dict, target_price=0,
                      price_source: str = "crm") -> dict:
        dialog = self.page.locator(
            f'{MODAL}:has(h2:text-is("{MODAL_TITLE}"))').first
        
        self._pick_agent(dialog)
        self._assert_modal_open(dialog, "agent")
        
        expected = target_price or info.get("amount", 0)
        # Order matters (Save stays disabled until all three are valid):
        # 1) Agent  2) Package  3) Total Amount / price  4) Save.
        
        package_info = self._pick_package(dialog, expected)
        self._assert_modal_open(dialog, "package")
        # doc §14: total must auto-populate. When we are going to set the
        # price ourselves an empty field is not a problem.
        will_set_price = bool(self.overwrite_price and target_price)
        if not will_set_price and not self._total_amount_ok(dialog):
            self.page.wait_for_timeout(1200)
            if not self._total_amount_ok(dialog):
                package_info = self._pick_package(dialog, expected)
                self.page.wait_for_timeout(1200)
                if not self._total_amount_ok(dialog):
                    raise DeliverError("total_amount",
                                       "did not populate after reselect")
        if will_set_price:
            self.page.wait_for_timeout(400)      # let the auto-fill land
            package_info.update(self._apply_price(dialog, target_price,
                                                  price_source))
            self._assert_modal_open(dialog, "price")
        save = self._save_button(dialog)
        save.wait_for(state="visible", timeout=6000)
        if not self._wait_until_enabled(save, 5000):
            raise DeliverError(
                "save", "save_button_disabled -- " + self._modal_state(dialog))
        self._wait_popups_closed()
        self._assert_modal_open(dialog, "final check")
        self._log("[deliver] modal ready: " + self._modal_state(dialog))
        # doc §15: persist READY_TO_SAVE, then click Save. No _center() here:
        # the dialog is a fixed layer; Playwright scrolls only if it must.
        self._safe_checkpoint()
        save.click(timeout=8000)
        try:
            dialog.wait_for(state="detached", timeout=9000)
        except PWError:
            # The modal is still open: Save was rejected (validation error,
            # server error, ...). Report the page's own words and close it
            # so the next step is not blocked by an overlay.
            note = self._visible_alerts()
            self._dismiss_modal(dialog)
            raise DeliverError(
                "save", "modal still open 9s after Save"
                + (f"; page says: {note}" if note else ""))
        # The modal closed on its own: the CRM accepted the Save. That is
        # the evidence verify_delivered() uses for its fast path (see there).
        package_info["modalClosed"] = True
        return package_info

    def _dismiss_modal(self, dialog) -> None:
        """Escape first; if the modal is still open, its Close / Cancel."""
        self._escape()
        self.page.wait_for_timeout(300)
        for selector in (None, 'button[aria-label="Close"]',
                         'button:has(span.sr-only:text-is("Close"))',
                         'button:has-text("Cancel")'):
            try:
                if dialog.count() == 0:
                    return
                if selector is None:
                    continue
                btn = dialog.locator(selector).first
                if btn.count() > 0:
                    btn.click(timeout=3000)
                    self.page.wait_for_timeout(300)
            except PWError:
                continue

    def _visible_alerts(self) -> str:
        """Text of visible alerts/toasts/validation messages (best effort)."""
        try:
            texts = self.page.evaluate(r"""() => Array.from(document.querySelectorAll(
                '[role="alert"], [role="status"], [data-sonner-toast], '
                + '[data-radix-toast-viewport] *, .text-destructive, .text-red-500'))
                .map(e => (e.innerText || '').replace(/\s+/g, ' ').trim())
                .filter(t => t && t.length < 240)""")
            seen: list = []
            for t in texts:
                if t not in seen:
                    seen.append(t)
            return " | ".join(seen[:4])
        except Exception:
            return ""

    def verify_delivered(self, name: str, started: float,
                         save_confirmed: bool = True) -> bool:
        """doc §16/§27: prove the move on the CRM itself, CHEAPEST check
        first.

        FIX (this revision, "the clean Save is already the proof"): once
        Save has been clicked and the modal closed on its own, the row
        leaving the Pending tab IS the CRM's own answer that the order
        moved -- no Delivered-tab round trip and no re-query loop (that trip
        was most of the per-customer verification time). The slower checks
        are kept exactly where they are still needed:
          * the row is still Pending -> a real failure (safe retry path);
          * the name is gone WITHOUT a clean Save (the idempotency
            pre-check) -> the Delivered tab is checked;
          * the search box no longer holds the name -> the empty table
            cannot be trusted, so Delivered is checked.
        Sets self.last_verify to how it was confirmed: 'row-delivered',
        'pending-gone' or 'delivered-tab'.
        """
        self.last_verify = ""
        phones = self.customer_phones(name)
        for attempt in range(VERIFY_ATTEMPTS):
            if self._deadline_left(started) <= 0:
                raise WatchdogTimeout("verification exceeded deadline")
            self.open_pending_tab()
            row, snap = self._search_and_find(name, phones)
            if row is not None:
                status = self.read_row(row)["status"].lower()
                if status.startswith("delivered"):
                    self.last_verify = "row-delivered"
                    return True
                if status.startswith("pending"):
                    if save_confirmed:
                        # the list can lag the Save by a beat: one more look
                        self.page.wait_for_timeout(700)
                        row2 = self.find_row(name, phones)
                        if row2 is not None and self.read_row(
                                row2)["status"].lower().startswith(
                                    "delivered"):
                            self.last_verify = "row-delivered"
                            return True
                    return False            # doc §6: safe retry path
                continue                    # unexpected status: look again
            # The name is gone from the Pending tab entirely.
            if save_confirmed and snap[0] == 0 and self._search_box_holds(
                    name):
                self._log(f"[deliver] {name}: gone from Pending right after "
                          "a clean Save -> Delivered")
                self.last_verify = "pending-gone"
                return True
            self.open_delivered_tab()
            self.search_customer(name)
            if self.find_row(name, phones) is not None:
                self.last_verify = "delivered-tab"
                return True
            time.sleep(min(1.5, backoff_delay(attempt + 1)))
        return False


    # ---- one customer, full recovery envelope (doc §18-§22, §28) -------------
    def process_customer(self, name: str) -> str:
        """Returns the final classification for one customer:
        SUCCESS / ALREADY_DELIVERED / NOT_FOUND / FAILED_FINAL / SKIPPED.
        All browser/network failures are contained here; nothing escapes
        to the top level (doc §31)."""
        started = time.monotonic()
        self.last_detail = ""
        self.last_note = ""
        sheet_phones = self.customer_phones(name)
        rec = self.store.record(name, phone=sheet_phones)
        if rec.state == SUCCESS and self.store.is_done(name, sheet_phones):
            self._log(f"[deliver] {name}: already completed -- skipping")
            return "SKIPPED"
        try:
            return self._process_customer_inner(name, rec, started)
        except ShutdownRequested:
            raise
        except WatchdogTimeout as exc:
            self.store.evidence(self.page, rec, "watchdog", str(exc))
            self.store.mark_failed(rec, "watchdog", str(exc), final=False)
            self.last_detail = f"watchdog: {exc}"
            self._say(f"[deliver] {name}: FAILED (watchdog) -> {exc}")
            return "FAILED"
        except (PWError, DeliverError) as exc:
            # doc §21: browser-level failures get dedicated recovery
            step = getattr(exc, "step", "browser")
            reason = str(exc)
            short = ((getattr(exc, "reason", None) or reason).strip()
                     .splitlines() or [""])[0][:300]
            self.last_detail = f"{step}: {short}"
            if self._is_browser_failure(exc) and (
                    self.browser_recoveries < MAX_BROWSER_RECOVERIES):
                self.browser_recoveries += 1
                self.store.evidence(self.page, rec, step, f"browser: {reason}")
                self.store.mark_failed(rec, step, f"browser: {reason}",
                                       final=False)
                raise BrowserRecoveryNeeded(reason) from exc
            if self._is_network_failure(exc):
                self.network_recoveries += 1
                self.store.evidence(self.page, rec, step, f"network: {reason}")
                self.store.mark_failed(
                    rec, step, f"network: {reason}", final=False)
                print(f"[deliver] {name}: network issue at {step} ({short}) "
                      f"-> waiting (recovery #{self.network_recoveries})",
                      flush=True)
                wait_for_network(self.store)
                return "RETRY_NETWORK"
            self.store.evidence(self.page, rec, step, reason)
            self.store.mark_failed(rec, step, reason, final=False)
            self._say(f"[deliver] {name}: FAILED at {step} -> {short}")
            return "FAILED"
        except Exception as exc:                     # noqa: BLE001
            # Anything unexpected (store bug, parsing bug, ...) stays inside
            # this customer: report it, keep the run alive. If a Save had
            # already been clicked, the next round finds the order Delivered
            # on the CRM and records ALREADY_DELIVERED.
            short = f"{type(exc).__name__}: {str(exc)[:240]}"
            self.last_detail = f"unexpected: {short}"
            self._say(f"[deliver] {name}: FAILED (unexpected) -> {short}")
            if self.verbose:
                traceback.print_exc()
            try:
                self.store.mark_failed(rec, "unexpected", short, final=False)
            except Exception:                        # noqa: BLE001
                pass
            return "FAILED"

    @staticmethod
    def _is_browser_failure(exc: Exception) -> bool:
        text = str(exc).lower()
        markers = ("target closed", "page closed", "browser disconnected",
                   "execution context destroyed", "browser has been closed")
        return isinstance(exc, PWError) and any(m in text for m in markers)

    @staticmethod
    def _is_network_failure(exc: Exception) -> bool:
        """Hard network markers always count. A bare Playwright timeout
        (selector not found, control disabled, ...) only counts when the
        connectivity probe really fails -- otherwise it is a normal step
        failure and must be reported as such, not as a 'network issue'."""
        if not isinstance(exc, PWError):
            return False
        text = str(exc).lower()
        hard = ("net::err", "ns_error", "err_connection", "connection",
                "network")
        if any(m in text for m in hard):
            return True
        if "timeout" in text or "timed out" in text:
            return not _probe_network()
        return False

    def _close_stray_layers(self) -> None:
        """Close a leftover row menu / Delivered modal after a failed step."""
        try:
            dialog = self.page.locator(
                f'{MODAL}:has(h2:text-is("{MODAL_TITLE}"))').first
            if dialog.count() > 0:
                self._dismiss_modal(dialog)
            elif self.page.locator(OPEN_MENU).count() > 0:
                self._escape()
                self.page.wait_for_timeout(200)
        except Exception:                            # noqa: BLE001
            pass

    def customer_phones(self, name: str) -> list:
        """The sheet's phone number(s) for this customer (may be empty).

        The second half of a customer's identity: two different people can
        share a name, so the Contact number decides which row is theirs and
        whether an earlier success was really theirs.
        """
        return list(self.phones.get(clean_name(name), []))

    def _target_price(self, name: str, info: dict):
        """(price, source): the Excel price when the workbook has a price
        column, else the order's Amount from the CRM row, else (0, 'none')."""
        excel = self.prices.get(clean_name(name))
        if excel:
            if info.get("amount") and info["amount"] != excel:
                self._log(f"[deliver] {name}: Excel price {excel} differs "
                          f"from the CRM row Amount {info['amount']} -- "
                          "using the Excel price")
            return excel, "excel"
        if info.get("amount"):
            return info["amount"], "crm"
        return 0, "none"

    def _process_customer_inner(self, name: str, rec: OrderRecord,
                                started: float) -> str:
        sheet_phones = self.customer_phones(name)
        # doc §10: idempotency pre-check on the CRM itself
        self.open_pending_tab()
        row, snap_pending = self._search_and_find(name, sheet_phones)
        if row is None:
            # The name is NOT in Pending: only now is the Delivered tab worth
            # a visit (it costs a tab click plus a search).
            self.open_delivered_tab()
            row_d, snap_delivered = self._search_and_find(name, sheet_phones)
            if row_d is not None:
                info_d = self.read_row(row_d)
                order_id = info_d["orderId"]
                self.store.mark_success(
                    rec, order_id or f"name:{name}",
                    phone=info_d.get("phones") or sheet_phones)
                self._log(f"[deliver] {name}: already Delivered on CRM "
                          f"(id={order_id})")
                return "ALREADY_DELIVERED"
            self.last_detail = (
                f"searched '{name}' -> Pending tab: "
                f"{self._fmt_snapshot(snap_pending)}; Delivered tab: "
                f"{self._fmt_snapshot(snap_delivered)}")
            self._say(f"[deliver] {name}: NOT_FOUND -- {self.last_detail}")
            self.store.evidence(self.page, rec, "not_found", self.last_detail)
            return "NOT_FOUND"
        info = self.read_row(row)
        order_id = info["orderId"]
        row_phones = info.get("phones") or sheet_phones
        rec.data["orderId"] = order_id
        self._safe_checkpoint()
        if info["status"].lower().startswith("delivered"):
            self.store.mark_success(rec, order_id, phone=row_phones)
            self._log(f"[deliver] {name}: row already Delivered "
                      f"(id={order_id})")
            return "ALREADY_DELIVERED"
        if not info["status"].lower().startswith("pending"):
            self.last_detail = (f"unexpected status '{info['status']}' "
                                f"(id={order_id}) -- not touching")
            self._say(f"[deliver] {name}: SKIPPED -- {self.last_detail}")
            return "SKIPPED"
        # happy path (doc §30)
        target_price, price_source = self._target_price(name, info)
        self._safe_transition(rec, ROW_FOUND, orderId=order_id)
        try:
            self.open_move_to_delivered(row, started)
            self._safe_transition(rec, MODAL_OPEN)
            package_info = self.fill_and_save(info, target_price,
                                              price_source)
        except BaseException:
            # A half-finished step must not leave a menu or the modal open:
            # the overlay would block every later click of this session.
            self._close_stray_layers()
            raise
        if package_info.get("priceOverwritten"):
            self.last_note = (
                f"price {package_info.get('formTotalBefore') or '?'} -> "
                f"{package_info['targetPrice']} ({price_source})")
            self._say(f"[deliver] {name}: Total Amount {self.last_note}")
        # Save has been clicked from here on: nothing below may abort the
        # verification against the CRM (dicts become JSON text, see
        # _safe_transition).
        self._safe_transition(rec, SAVE_SUBMITTED, package=package_info)
        self._safe_checkpoint()
        self._safe_transition(rec, VERIFYING)
        # The modal closed on its own -> the CRM took the Save, so a Pending
        # search that no longer shows this customer is already the answer
        # (see verify_delivered: no Delivered-tab trip needed).
        save_confirmed = bool(package_info.get("modalClosed"))
        if self.verify_delivered(name, started,
                                 save_confirmed=save_confirmed):
            self.store.mark_success(rec, order_id, phone=row_phones)
            self._log(f"[deliver] {name}: verified Delivered on CRM "
                      f"(id={order_id}, via {self.last_verify or 'verify'}, "
                      f"package={package_info['packageLabel']})")
            return "SUCCESS"
        self.store.mark_failed(rec, "verify",
                               "crm never showed Delivered", final=False)
        self.last_detail = ("verify: Save clicked but the CRM never showed "
                            f"Delivered (id={order_id})")
        self._say(f"[deliver] {name}: FAILED -- {self.last_detail}")
        return "FAILED"


class BrowserRecoveryNeeded(RuntimeError):
    """doc §21: page/browser died -- rebuild and resume."""



# ============================ main worker (doc §30) =========================


def _install_signal_handlers(store) -> None:
    """doc §29, two-stage: first Ctrl+C = finish the current customer and
    exit cleanly (state persisted); second Ctrl+C = stop immediately."""
    import signal

    def _handler(signum, _frame):
        if getattr(store, "shutdown", False):
            raise KeyboardInterrupt
        store.shutdown = True
        print("\n[deliver] stopping after the current customer "
              "(press Ctrl+C again to stop now)", flush=True)

    for sig in (signal.SIGINT, signal.SIGTERM):
        try:
            signal.signal(sig, _handler)
        except (ValueError, OSError):
            pass


class StopRun(Exception):
    """Internal: max-success reached -- leave the loop gracefully and
    still run the final sanity check + report."""


SUCCESS_OUTCOMES = ("SUCCESS", "ALREADY_DELIVERED")


def run(client: str, customers: list[str], config: dict,
        headful: bool = True, max_success: int | None = None,
        verbose: bool = False, prices: dict | None = None,
        not_found_csv: Path | None = None, source_name: str = "",
        phones: dict | None = None) -> dict:
    """doc §30 worker: lock -> load state -> browser -> auth -> filters ->
    per-customer loop with recovery -> reconcile -> report (doc §26).

    Quiet by default (one line per customer + summary). SQLite store at
    <client>/state/deliver/deliver_progress.db. --lock relaunching lives
    in main(); max_success stops the loop gracefully via StopRun.

    prices: {clean_name(customer): price} from the Excel price column (see
    load_customer_prices); phones: {clean_name(customer): [phone, ...]} from
    the Excel phone columns (see load_customer_phones) -- the second half of
    a customer's identity, so a repeated name is never mistaken for the same
    person; not_found_csv: where names found in neither Pending nor
    Delivered are exported for a human (default
    <client>/state/deliver/not_found.csv).
    """
    period = config.get("period", DEFAULT_PERIOD)
    manager = WorkspaceManager()
    canonical = manager.resolve_client_id(client)
    paths = manager.client_paths(canonical)
    store = SqliteDeliverStore(canonical, period, paths.state_dir / "deliver")
    price_map = {clean_name(k): v for k, v in (prices or {}).items()}
    phone_map = {clean_name(k): phone_keys(v)
                 for k, v in (phones or {}).items()}
    if not_found_csv is None:
        cfg_csv = config.get("notFoundCsv")
        not_found_csv = (Path(cfg_csv) if cfg_csv
                         else paths.state_dir / "deliver" / "not_found.csv")

    def _new_driver(page_):
        drv = DeliverDriver(page_, store, config, verbose=verbose)
        drv.prices = price_map
        drv.phones = phone_map
        return drv

    _install_signal_handlers(store)
    try:
        manager.validate_client_ready(canonical)
    except Exception as exc:
        print(f"[deliver] client not ready: {exc}", flush=True)
        raise

    report = {
        "runId": f"deliver_{now_iso()}",
        "client": canonical,
        "period": period,
        "startedAt": now_iso(),
        "total": len(customers),
        "success": 0,
        "failed": 0,
        "alreadyDelivered": 0,
        "skipped": 0,
        "notFound": 0,
        "networkRecoveries": 0,
        "browserRecoveries": 0,
        "notFoundExported": [],
        "notFoundCsv": str(not_found_csv),
        "customersWithPhone": sum(
            1 for name in customers if phone_map.get(clean_name(name))),
        "results": {},
    }
    atomic_write_json(store.report_path, report)

    with JobLock(store.lock_path):
        with sync_playwright() as p:
            browser = p.chromium.launch(
                headless=not headful,
                args=["--disable-background-timer-throttling",
                      "--disable-backgrounding-occluded-windows",
                      "--disable-renderer-backgrounding"],
            )
            context = None
            driver = None
            try:
                context, page = login_with_session_cache(
                    browser, LOGIN_URL, TARGET_URL, LOGGED_IN_SELECTOR,
                    storage_path=str(paths.auth_dir / "session_state.json"),
                    network_wait_timeout_ms=LOGIN_NETWORK_WAIT_MS,
                    client_id=canonical,
                    credential_reference=manager.credential_reference(canonical),
                    env_file=str(manager.shared_credentials_env_path()),
                    cache_file=str(paths.auth_dir / "credentials.json"),
                )
                # Second, independent readiness check (mirrors
                # run_automation.py) -- covers the case where login
                # reported success but the orders page is still rendering.
                _confirm_orders_page(page)
                _ensure_viewport(page)
                print("[deliver] logged in and on the orders page.",
                      flush=True)
                driver = _new_driver(page)
                # The User filter trigger is disabled by the CRM until a
                # 'Filter By' chip (Added By / Assigned By) has been picked
                # first, so the chips MUST be applied before ensure_filters()
                # touches User. (ensure_filters() now also waits for User to
                # become enabled and fails fast with a diagnostic.)
                driver.ensure_form_chips()
                driver.ensure_filters(canonical)
                driver.submit_search()
                # FIX (this revision, "the run that read pending=0
                # delivered=0"): the badges are painted with the filtered
                # list, so wait for the list itself before reading them --
                # reading too early made every later search report "No
                # orders match your filters" (false NOT_FOUND).
                driver.wait_for_orders_ready()
                pending_before = driver.open_pending_tab()
                delivered_before = driver.open_delivered_tab()
                print(f"[deliver] pending={pending_before} "
                      f"delivered={delivered_before}", flush=True)
                if not pending_before and not delivered_before:
                    print("[deliver] warning: both tab badges read 0 -- the "
                          "orders list may not have loaded, so searches can "
                          "report NOT_FOUND for orders that are really "
                          "there.", flush=True)

                indexed = [
                    (num, name) for num, name in enumerate(customers, 1)
                    if not store.is_done(name, phone_map.get(clean_name(name)))
                ]
                skipped_pre = len(customers) - len(indexed)
                if skipped_pre and verbose:
                    print(f"[deliver] {skipped_pre} already done -- skipping",
                          flush=True)
                for num, name in indexed:
                    if store.shutdown:
                        raise ShutdownRequested("shutdown requested")
                    started = time.monotonic()
                    outcome = "FAILED"
                    for round_no in range(1, 4):        # §18: bounded rounds
                        try:
                            outcome = driver.process_customer(name)
                        except BrowserRecoveryNeeded as exc:
                            # doc §21: persist, rebuild browser + session,
                            # re-verify, resume (never lose state)
                            report["browserRecoveries"] += 1
                            atomic_write_json(store.report_path, report)
                            print(f"[deliver] browser recovery: {exc}",
                                  flush=True)
                            try:
                                if context is not None:
                                    context.close()
                            except Exception:
                                pass
                            context, page = login_with_session_cache(
                                browser, LOGIN_URL, TARGET_URL,
                                LOGGED_IN_SELECTOR,
                                storage_path=str(
                                    paths.auth_dir / "session_state.json"),
                                network_wait_timeout_ms=LOGIN_NETWORK_WAIT_MS,
                                client_id=canonical,
                                credential_reference=(
                                    manager.credential_reference(canonical)),
                                env_file=str(
                                    manager.shared_credentials_env_path()),
                                cache_file=str(
                                    paths.auth_dir / "credentials.json"),
                            )
                            # Same second readiness check on the recovery
                            # path, since a rebuilt session is exactly as
                            # likely to need the extra margin as the
                            # initial login.
                            _confirm_orders_page(page)
                            _ensure_viewport(page)
                            driver = _new_driver(page)
                            driver.network_recoveries = (
                                report["networkRecoveries"])
                            driver.browser_recoveries = (
                                report["browserRecoveries"])
                            # Same ordering as the initial login -- Filter By
                            # chips before the User trigger.
                            driver.ensure_form_chips()
                            driver.ensure_filters(canonical)
                            driver.submit_search()
                            outcome = "RETRY_BROWSER"
                            continue
                        if outcome in ("SUCCESS", "ALREADY_DELIVERED",
                                       "SKIPPED", "NOT_FOUND"):
                            break
                        if outcome in ("RETRY_NETWORK", "RETRY_BROWSER"):
                            continue
                        time.sleep(backoff_delay(round_no))
                    report["results"][name] = outcome
                    key = {"SUCCESS": "success",
                           "ALREADY_DELIVERED": "alreadyDelivered",
                           "SKIPPED": "skipped",
                           "NOT_FOUND": "notFound"}.get(outcome)
                    if key:
                        report[key] += 1
                    elif outcome in ("FAILED", "RETRY_NETWORK",
                                     "RETRY_BROWSER"):
                        report["failed"] += 1
                    report["networkRecoveries"] = max(
                        report["networkRecoveries"],
                        driver.network_recoveries)
                    report["browserRecoveries"] = max(
                        report["browserRecoveries"],
                        driver.browser_recoveries)
                    atomic_write_json(store.report_path, report)
                    row = store.row(name) or {}
                    dur = time.monotonic() - started
                    detail = ""
                    if outcome not in SUCCESS_OUTCOMES and driver.last_detail:
                        detail = f" -- {driver.last_detail}"
                    elif outcome == "SUCCESS" and driver.last_note:
                        detail = f" [{driver.last_note}]"
                    if outcome == "NOT_FOUND":
                        # Not in Pending, not in Delivered: a human has to
                        # find out why (name never uploaded / misspelt).
                        try:
                            if export_not_found(
                                    not_found_csv, canonical, name,
                                    driver.last_detail,
                                    price_map.get(clean_name(name)),
                                    source_name, report["runId"]):
                                report["notFoundExported"].append(name)
                        except Exception as exc:     # noqa: BLE001
                            print(f"[deliver] warning: could not write "
                                  f"{not_found_csv}: {exc}", flush=True)
                    print(f"[deliver] {num}/{len(customers)} {name} -> "
                          f"{outcome} (id={row.get('orderId') or '?'}, "
                          f"{dur:.0f}s){detail}", flush=True)
                    if driver.browser_recoveries >= MAX_BROWSER_RECOVERIES:
                        print("[deliver] browser recovery budget exhausted "
                              "-- stopping this run", flush=True)
                        break
                    if (max_success is not None
                            and report["success"] >= max_success):
                        print(f"[deliver] max-success {max_success} reached "
                              f"-- stopping", flush=True)
                        raise StopRun()

                # doc V2: Delivered-tab count sanity check. FIX: only rows
                # this run actually MOVED (SUCCESS) change the Delivered
                # count; ALREADY_DELIVERED rows were already in
                # `delivered_before`, so counting them raised a false
                # WARNING on every run that contained one.
                driver.clear_search()
                delivered_after = driver.open_delivered_tab()
                moved = sum(1 for v in report["results"].values()
                            if v == "SUCCESS")
                report["deliveredBefore"] = delivered_before
                report["deliveredAfter"] = delivered_after
                report["countSanity"] = (
                    delivered_after - delivered_before == moved)
                if not report["countSanity"]:
                    print(f"[deliver] WARNING: delivered delta "
                          f"({delivered_after - delivered_before}) != "
                          f"moved this run ({moved}) -- see results map",
                          flush=True)
            except (ShutdownRequested, StopRun, KeyboardInterrupt):
                print("[deliver] stopped -- state saved.", flush=True)
            finally:
                report["finishedAt"] = now_iso()
                atomic_write_json(store.report_path, report)
                try:
                    if context is not None:
                        context.close()
                except Exception:
                    pass
                try:
                    browser.close()
                except Exception:
                    pass
    if report["notFoundExported"]:
        print(f"[deliver] {len(report['notFoundExported'])} name(s) not in "
              f"Pending or Delivered -> exported for a human check: "
              f"{not_found_csv}", flush=True)
    print(f"[deliver] {report['success']} success, "
          f"{report['alreadyDelivered']} already-delivered, "
          f"{report['failed']} failed, {report['notFound']} not-found, "
          f"{report['skipped']} skipped "
          f"(recoveries: net={report['networkRecoveries']}, "
          f"browser={report['browserRecoveries']}) "
          f"-- db {store.db_path}", flush=True)
    if verbose:
        print(f"[deliver] store states: {store.counts()}", flush=True)
        print(json.dumps(report, indent=2, default=str), flush=True)
    store.close()
    return report


def main() -> None:
    parser = argparse.ArgumentParser(
        description="Move matching PENDING orders to DELIVERED (verified on "
                    "the CRM before success is recorded).")
    parser.add_argument("--client", required=True,
                        help="client name or canonical client id")
    parser.add_argument("--mark-deliver", action="store_true",
                        help="actually run the deliver flow (required)")
    parser.add_argument("--lock", action="store_true",
                        help="resilient mode: relaunch the browser session "
                             "on any crash and keep going until Ctrl+C")
    parser.add_argument("--customers", default="",
                        help="path to .txt/.csv/.json/.xlsx of customer names "
                             "(default: latest file in the client's "
                             "jobs/status dir)")
    parser.add_argument("--config", default="",
                        help="path to deliver_config.json")
    parser.add_argument("--period", default=DEFAULT_PERIOD,
                        help="Period filter value (default: This Month)")
    parser.add_argument("--headless", action="store_true",
                        help="run the browser headless")
    parser.add_argument("--max-success", type=int, default=None,
                        help="stop gracefully after this many successes")
    parser.add_argument("--limit", type=int, default=None,
                        help="attempt at most this many customers")
    parser.add_argument("--price-column", default="",
                        help="header of the price column in the .xlsx/.csv "
                             "(default: auto-detect Amount/Price/Total...)")
    parser.add_argument("--not-found-csv", default="",
                        help="where to export names found in neither "
                             "Pending nor Delivered (default: <client>/"
                             "state/deliver/not_found.csv)")
    parser.add_argument("--verbose", action="store_true",
                        help="detailed step-by-step logging")
    args = parser.parse_args()
    for stream in (sys.stdout, sys.stderr):
        try:                       # a cp1252 console/pipe can't print "₦"
            stream.reconfigure(errors="replace")
        except Exception:                             # noqa: BLE001
            pass

    if not args.mark_deliver:
        print("[deliver] nothing to do -- add --mark-deliver. Example:")
        print("  python run_deliver.py --client michael "
              "--mark-deliver --lock")
        return

    manager = WorkspaceManager()
    distribute_inbox(manager)

    config = load_config(Path(args.config) if args.config else None)
    if args.period and args.period != DEFAULT_PERIOD:
        config["period"] = args.period

    canonical = manager.resolve_client_id(args.client)
    job_log = _install_job_log(manager, canonical)
    if job_log:
        print(f"[deliver] job log: {job_log}", flush=True)
    if args.customers:
        source = Path(args.customers)
    else:
        source = _latest_status_file(canonical)
        if source is None:
            print(f"[deliver] no customer file: pass --customers, or drop "
                  f"a file with '{manager.name_key_for(canonical)}' in the "
                  f"name into apps/sniper/status_inbox/", flush=True)
            return
    names = load_customers(source)
    if args.limit:
        names = names[:args.limit]
    if not names:
        print(f"[deliver] no customer names in {source}"
              + (f" -- {_selection_note}" if _selection_note else ""),
              flush=True)
        return
    price_col = args.price_column or config.get("priceColumn", "")
    prices, price_header, conflicts = {}, "", set()
    try:
        prices, price_header, conflicts = load_customer_prices(
            source, price_col)
    except Exception as exc:                          # noqa: BLE001
        print(f"[deliver] warning: could not read prices from "
              f"{source.name}: {exc}", flush=True)
    if prices:
        print(f"[deliver] price column '{price_header}': "
              f"{len(prices)} customer price(s)"
              + (f"; {len(conflicts)} name(s) with conflicting prices use "
                 "the CRM row Amount" if conflicts else ""), flush=True)
    else:
        print(f"[deliver] no price column found in {source.name} "
              f"(looked for {', '.join(PRICE_HEADERS[:4])}, ...) -- using "
              "each order's Amount from the CRM row; pass --price-column "
              "NAME to point at the right column", flush=True)

    phones, phone_headers = {}, ()
    try:
        phones, phone_headers = load_customer_phones(source)
    except Exception as exc:                          # noqa: BLE001
        print(f"[deliver] warning: could not read phone numbers from "
              f"{source.name}: {exc}", flush=True)
    if phones:
        print(f"[deliver] phone column(s) "
              f"{', '.join(phone_headers)!r}: {len(phones)} customer "
              "phone(s) -- used to tell same-named customers apart and to "
              "skip only that customer's own earlier success", flush=True)
    else:
        print(f"[deliver] no phone column in {source.name} -- same-named "
              "customers can only be told apart by name", flush=True)

    if _selection_note:
        print(f"[deliver] sheet status: {_selection_note}", flush=True)
    print(f"[deliver] {canonical}: {len(names)} customer(s) from "
          f"{source.name} (period={config.get('period', DEFAULT_PERIOD)})",
          flush=True)
    session = 0
    while True:
        try:
            run(canonical, names, config, headful=not args.headless,
                max_success=args.max_success, verbose=args.verbose,
                prices=prices, source_name=source.name, phones=phones,
                not_found_csv=(Path(args.not_found_csv)
                               if args.not_found_csv else None))
            break
        except MissingCredentialsError:
            raise
        except KeyboardInterrupt:
            # graceful two-stage Ctrl+C is handled inside run(); a raw
            # KeyboardInterrupt here (before/after sessions) just stops.
            print("[deliver] stopped by user.", flush=True)
            return
        except Exception as exc:
            session += 1
            if args.verbose:
                traceback.print_exc()
            if not args.lock or session >= 5:
                print(f"[deliver] run ended with error after "
                      f"{session} session(s): {type(exc).__name__}: {exc}",
                      flush=True)
                return
            print(f"[deliver] session crashed "
                  f"({type(exc).__name__}: {exc}) -- relaunching "
                  f"(Ctrl+C to stop)", flush=True)
            time.sleep(min(30.0, backoff_delay(session)))
    # (run() already prints the report when --verbose is set)


def _latest_status_file(canonical: str):
    """Newest supported customer file in the client's jobs/status dir."""
    status_dir = (WorkspaceManager().client_paths(canonical).jobs_dir
                  / "status")
    if not status_dir.exists():
        return None
    candidates = [p for p in status_dir.iterdir()
                  if p.is_file()
                  and p.suffix.lower() in {".xlsx", ".xls", ".csv",
                                           ".json", ".txt"}]
    if not candidates:
        return None
    return max(candidates, key=lambda p: p.stat().st_mtime)


if __name__ == "__main__":
    main()
