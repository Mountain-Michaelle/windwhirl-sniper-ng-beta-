# ===================================================================
# Sniper client credentials - TEMPLATE ONLY
# ===================================================================
# Copy the required entries into your PRIVATE .env file.
# Never commit .env, passwords, browser session state, or tokens.
#
# The upload code reads environment variables through python-dotenv.
# Client profiles store only a credential_reference such as:
# credential_reference: env:ACME
#
# Keep one clearly labeled block per client. Replace CHANGE_ME values before
# running that client's upload. Do not reuse SNIPER_EMAIL/PASSWORD for a
# different client when multiple clients are active.

# -------------------------------------------------------------------
# Client: Acme
# Canonical client ID: client_acme
# Profile: apps/sniper/clients/client_acme/profile/client.yaml
# Credential reference: env:ACME_A1B2C3D4
# -------------------------------------------------------------------
ACME_A1B2C3D4_EMAIL=CHANGE_ME
ACME_A1B2C3D4_PASSWORD=CHANGE_ME

# -------------------------------------------------------------------
# Client: Beta
# Canonical client ID: client_beta
# Profile: apps/sniper/clients/client_beta/profile/client.yaml
# Credential reference: env:B2C3D4E5
# -------------------------------------------------------------------
B2C3D4E5_EMAIL=CHANGE_ME
B2C3D4E5_PASSWORD=CHANGE_ME

# -------------------------------------------------------------------
# Legacy single-client fallback (only use when no client-specific
# credential_reference or client-specific variables are configured).
# -------------------------------------------------------------------
# SNIPER_EMAIL=CHANGE_ME
# SNIPER_PASSWORD=CHANGE_ME
